# Storyblok Delivery API — REQUIRED.
# The site reads the Home story from Storyblok at runtime, so this must be set
# (locally in .env, and as an environment variable on Vercel).
# Get the "preview" access token from Storyblok → Settings → Access Tokens.
STORYBLOK_DELIVERY_API_TOKEN=your_preview_access_token

# Space region: eu | us | ap | ca | cn  (this project's space is eu)
STORYBLOK_REGION=eu

# Optional — only when using a custom/blueprint Delivery API endpoint.
# STORYBLOK_API_BASE_URL=

# NOTE: the Management API token used by scripts/storyblok-setup.mjs is NOT
# stored here. Pass it inline only when seeding, e.g.:
#   SB_MANAGEMENT_TOKEN=sb_pat_xxx node scripts/storyblok-setup.mjs

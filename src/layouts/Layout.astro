---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/patterns.css';

export interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	ogType?: 'website' | 'article';
	noindex?: boolean;
}

const {
	title = 'Wirebox — Bespoke software development that enhances your brand',
	description = 'Since 2005, Wirebox has built engaging digital experiences for incredible brands — combining web development expertise with the instincts of a digital marketing firm.',
	canonical,
	ogImage = '/og-default.png',
	ogType = 'website',
	noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:site_name" content="Wirebox" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<meta name="theme-color" content="#5418D0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>

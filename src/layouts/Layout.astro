---
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/patterns.css';
import CookieBanner from '../components/CookieBanner.astro';
import { loadSiteScripts } from '../lib/site-scripts';
import { renderScripts } from '../data/site-scripts.mjs';

export interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	ogType?: 'website' | 'article';
	noindex?: boolean;
}

const {
	title = 'Wirebox — Bespoke software development that enhances your brand',
	description = 'Since 2005, Wirebox has built engaging digital experiences for incredible brands — combining web development expertise with the instincts of a digital marketing firm.',
	canonical,
	ogImage = '/og-default.png',
	ogType = 'website',
	noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;

// Third-party scripts (GTM, Crazy Egg, chat widgets…) come from the Storyblok
// "Site settings" story so they can be managed without a deploy; the bundled
// list is the fallback. Rendered as raw HTML at three injection points.
const { scripts: siteScripts } = await loadSiteScripts();
const headScripts = renderScripts(siteScripts, 'head');
const bodyStartScripts = renderScripts(siteScripts, 'body_start');
const bodyEndScripts = renderScripts(siteScripts, 'body_end');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- Site scripts: head (GTM must stay first — it's first in the list) -->
		<Fragment set:html={headScripts} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:site_name" content="Wirebox" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<meta name="theme-color" content="#5418D0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<slot name="head" />
	</head>
	<body>
		<!-- Site scripts: start of body (GTM noscript lives here) -->
		<Fragment set:html={bodyStartScripts} />
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
		<CookieBanner />
		<!-- Site scripts: end of body -->
		<Fragment set:html={bodyEndScripts} />
	</body>
</html>

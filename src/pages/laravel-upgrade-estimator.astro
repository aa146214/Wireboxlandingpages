---
import { randomUUID } from 'node:crypto';
import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import Layout from '../layouts/Layout.astro';
import { buildEstimatorBody, ESTIMATOR_SEO } from '../data/estimator-content.mjs';

/**
 * Laravel upgrade estimator.
 *
 * Its own route for the same reason as /laravel: it's a campaign URL, so an
 * unpublished story or a Storyblok outage must not 404 paid traffic. The
 * fallback is built from the same content module the seed uses.
 */
const FALLBACK = {
	component: 'page',
	...ESTIMATOR_SEO,
	body: buildEstimatorBody({
		sb: (component: string, fields: Record<string, unknown> = {}) => ({ _uid: randomUUID(), component, ...fields }),
		A: (name: string) => ({ filename: `/seed-assets/support/${name}`, alt: '' }),
		mlink: (url: string) => url,
		header: { _uid: 'fallback-header', component: 'header', nav: [], socials: [], phone_label: 'call us on:', phone_number: '0207 993 5485' },
		locations: () => ({ _uid: 'fallback-locations', component: 'locations' }),
		footer: () => ({ _uid: 'fallback-footer', component: 'footer' }),
	}),
};

let content: Record<string, unknown> = FALLBACK;
try {
	const storyblokApi = useStoryblokApi();
	const { data } = await storyblokApi.get('cdn/stories/laravel-upgrade-estimator', {
		version: 'published',
		cv: Date.now(),
	});
	if (data?.story?.content) content = data.story.content;
} catch (err) {
	console.warn('[estimator] Storyblok fetch failed — using bundled content:', (err as Error).message);
}

const seoTitle = (content.seo_title as string) || ESTIMATOR_SEO.seo_title;
const seoDescription = (content.seo_description as string) || ESTIMATOR_SEO.seo_description;
const noindex = Boolean(content.seo_noindex);
---

<Layout title={seoTitle} description={seoDescription} noindex={noindex}>
	<StoryblokComponent blok={content} />
</Layout>

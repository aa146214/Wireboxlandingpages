---
import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import Layout from '../layouts/Layout.astro';
import { getHomeContent } from '../data/home-content';
import { buildHomeJsonLd } from '../lib/schema';

// Content is served from Storyblok (Home story). The local fixture remains as a
// build-time fallback so the page still renders if the CMS is unreachable.
let content;
try {
	const storyblokApi = useStoryblokApi();
	// `cv: Date.now()` forces the latest published content on every request —
	// without it the client reuses a cached cache-version and serves stale
	// content after an editor publishes (see [...slug].astro).
	const { data } = await storyblokApi.get('cdn/stories/home', { version: 'published', cv: Date.now() });
	content = data.story.content;
} catch (err) {
	console.warn('[index] Storyblok fetch failed — using local fixture:', (err as Error).message);
	content = getHomeContent();
}

// Pull SEO fields off the page story (fall back to the Layout defaults).
const seoTitle: string | undefined = content?.seo_title || undefined;
const seoDescription: string | undefined = content?.seo_description || undefined;

// schema.org structured data (Organization + offices + FAQPage).
const origin = Astro.site?.origin ?? Astro.url.origin;
const jsonLd = JSON.stringify(buildHomeJsonLd(content, origin)).replace(/</g, '\\u003c');
---

<Layout title={seoTitle} description={seoDescription}>
	<script type="application/ld+json" slot="head" set:html={jsonLd} is:inline />
	<StoryblokComponent blok={content} />
</Layout>

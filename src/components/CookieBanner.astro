---
/**
 * Informational cookie notice — a pixel-for-pixel match of wirebox.co.uk's
 * banner: a full-width fixed bottom bar (bg #161026) with the notice text on
 * the left and two pill buttons on the right. Analytics load on page load; the
 * bar is dismissible (not a consent gate). "Manage Cookies" is a primary link
 * to the privacy policy (same as the live site — not a preferences panel),
 * "Accept" dismisses.
 *
 * Colours map the live site's roles onto our design tokens (their violet →
 * our primary, their off-white → our light-bg), not their raw hex values.
 */
import { PRIVACY_URL } from '../lib/analytics';
---

<div class="cookie" data-cookie-banner hidden>
	<div class="cookie__inner container">
		<p class="cookie__text">
			We are using cookies to give you the best experience on our website. You can
			find out more about cookies on our
			<a class="cookie__link" href={PRIVACY_URL}>privacy policy</a>.
		</p>
		<div class="cookie__actions">
			<a class="cookie__btn cookie__btn--manage" href={PRIVACY_URL}>Manage Cookies</a>
			<button class="cookie__btn cookie__btn--accept" type="button" data-cookie-accept>Accept</button>
		</div>
	</div>
</div>

<style>
	/* Full-width bar pinned to the bottom (matches their #cookie-notice-bar). */
	.cookie {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		z-index: var(--z-header);
		background: var(--surface-invert); /* #161026 — same as live site */
		color: var(--color-white);
		border-top: 1px solid var(--border-on-dark-faint);
	}
	.cookie[hidden] {
		display: none;
	}
	.cookie__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-block: 1rem;
	}
	.cookie__text {
		flex: 1 1 20rem;
		margin: 0;
		font-size: var(--fs-small);
		line-height: var(--lh-body);
	}
	.cookie__link {
		color: var(--color-light-green); /* green reads better on the dark bar than the live site's violet */
		text-decoration: none;
	}
	.cookie__link:hover {
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.cookie__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.cookie__btn {
		flex-shrink: 0;
		padding: 0.5rem 1rem;
		border: 1px solid transparent;
		border-radius: var(--radius-pill);
		font-size: var(--fs-small);
		font-weight: var(--fw-regular);
		line-height: 1.3;
		cursor: pointer;
		white-space: nowrap;
		transition: opacity var(--dur-fast) var(--ease-out);
	}
	.cookie__btn:hover {
		opacity: 0.9;
	}
	/* "Manage Cookies" — our violet (their btn-primary role). */
	.cookie__btn--manage {
		background: var(--color-primary-blue);
		border-color: var(--color-primary-blue);
		color: var(--color-white);
	}
	/* "Accept" — our off-white (their btn-light role). */
	.cookie__btn--accept {
		background: var(--color-light-bg-2);
		border-color: var(--color-light-bg-2);
		color: var(--color-headings-dark);
	}
	.cookie__btn:focus-visible {
		outline: 2px solid var(--color-cyan);
		outline-offset: 2px;
	}
</style>

<script is:inline>
	(function () {
		var KEY = 'wb-cookie-notice';
		var banner = document.querySelector('[data-cookie-banner]');
		if (!banner) return;
		try {
			if (localStorage.getItem(KEY) === 'dismissed') return;
		} catch (e) {}
		banner.hidden = false;
		var accept = banner.querySelector('[data-cookie-accept]');
		if (accept) {
			accept.addEventListener('click', function () {
				banner.hidden = true;
				try {
					localStorage.setItem(KEY, 'dismissed');
				} catch (e) {}
			});
		}
	})();
</script>

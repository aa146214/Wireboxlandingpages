---
interface Props {
    imageSrc: string;
    class?: string;
}

const {
    imageSrc,
    class: className = '',
} = Astro.props;
---

<section class:list={['hero', className]}>
	<div class="hero__background" aria-hidden="true">
		<img
			src={imageSrc}
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
	</div>

    <div class="hero__inner container">
		<slot />
    </div>
</section>

<style>
    .hero {
        position: relative;
        background: var(--color-primary-blue);
        color: var(--color-white);
        overflow: hidden;
        isolation: isolate;
    }

    /* Absolute Background Image */
    .hero__background {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
    }

    .hero__background img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

	.hero__background::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--color-dark-blue);
		opacity: 0.85;
		z-index: 0;
	}

    .hero__inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .hero__inner {
            min-height: auto;
        }
        .hero__content {
            max-width: 100%;
            padding-block: 3rem;
        }
    }
</style>

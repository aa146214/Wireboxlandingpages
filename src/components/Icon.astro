---
import { icons, type IconName } from '../lib/icons';

interface Props {
	name: IconName;
	size?: number | string;
	label?: string;
	class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
const a11y = label
	? { role: 'img', 'aria-label': label }
	: { 'aria-hidden': 'true', focusable: 'false' };
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	width={size}
	height={size}
	class={className}
	{...a11y}
	set:html={icons[name]}
/>

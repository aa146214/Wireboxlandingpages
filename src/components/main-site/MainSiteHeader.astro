---
/**
 * Header of the main wirebox.co.uk site, rebuilt to match it: fixed translucent
 * bar, logo, nav whose grouped items open a right-hand slide-out drawer (the
 * site's Bootstrap "offcanvas"), the violet contact pill and social icons.
 * Below 1200px the nav collapses behind a hamburger, as on the live site.
 *
 * Measurements come from the live site's computed styles (its rem = 21px).
 * The live logo is a Lottie animation; this uses the same logo as a static SVG.
 *
 * Content (logo, menu, drawers, contact pill, socials) comes from the Storyblok
 * `main_site_header` blok; see src/lib/main-site.ts.
 */
import '../../styles/main-site.css';
import { storyblokEditable } from '@storyblok/astro';
import { mainHeader } from '../../lib/main-site';
import type { MainNavEntry } from '../../data/main-site-nav';

/** Storyblok `main_site_header` blok; every field falls back to the code defaults. */
const { blok } = Astro.props;
const h = mainHeader(blok);

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const isGroup = (e: MainNavEntry): e is Extract<MainNavEntry, { children: unknown }> => 'children' in e;
const drawers = h.nav.filter((i) => i.drawer);
---

<header class="ms-header" {...(blok ? storyblokEditable(blok) : {})}>
	<nav class="ms-nav" aria-label="Main" data-ms-nav>
		<div class="ms-container ms-nav__inner">
			<a class="ms-nav__logo" href={h.homeHref} aria-label="Wirebox — home">
				<img src={h.logo} alt={h.logoAlt} width="150" height="38" />
			</a>

			<button
				class="ms-nav__toggler"
				type="button"
				aria-controls="ms-nav-collapse"
				aria-expanded="false"
				aria-label="Toggle navigation"
				data-ms-toggler
			>
				<span class="ms-nav__toggler-icon" aria-hidden="true"></span>
			</button>

			<div class="ms-nav__collapse" id="ms-nav-collapse" data-ms-collapse>
				<ul class="ms-nav__list">
					{
						h.nav.map((item) => (
							<li class="ms-nav__item">
								{item.drawer ? (
									<button
										class="ms-nav__link ms-nav__link--toggle"
										type="button"
										aria-haspopup="dialog"
										aria-controls={`ms-drawer-${slug(item.label)}`}
										data-ms-drawer-open={`ms-drawer-${slug(item.label)}`}
									>
										{item.label}
									</button>
								) : (
									<a class="ms-nav__link" href={item.href}>
										{item.label}
									</a>
								)}
							</li>
						))
					}
					<li class="ms-nav__item ms-nav__item--btn">
						<a class="ms-nav__btn" href={h.contactHref}>{h.contactLabel}</a>
					</li>
					<li class="ms-nav__item ms-nav__socials">
						{
							h.socials.map((s) => (
								<a class="ms-nav__social" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
									<i class={`${s.icon} ms-icon`} aria-hidden="true" />
								</a>
							))
						}
					</li>
				</ul>
			</div>
		</div>
	</nav>

	<!-- Clipping layer: keeps the closed (off-screen) drawers from widening the page. -->
	<div class="ms-layer">
	<div class="ms-backdrop" data-ms-backdrop></div>
	{
		drawers.map((item) => {
			const id = `ms-drawer-${slug(item.label)}`;
			return (
				<div class="ms-drawer" id={id} role="dialog" aria-modal="true" aria-labelledby={`${id}-label`} data-ms-drawer>
					<div class="ms-drawer__header">
						<h3 class="ms-drawer__heading" id={`${id}-label`}>
							{item.label}
						</h3>
						<button class="ms-drawer__close" type="button" aria-label="Close" data-ms-drawer-close />
					</div>
					<div class="ms-drawer__body">
						<ul class="ms-drawer__list">
							{item.drawer!.map((entry) =>
								isGroup(entry) ? (
									<li>
										<button
											class="ms-drawer__group"
											type="button"
											aria-expanded="false"
											aria-controls={`${id}-${slug(entry.label)}`}
											data-ms-group
										>
											{entry.label}
										</button>
										<div class="ms-drawer__sub" id={`${id}-${slug(entry.label)}`} hidden>
											<ul class="ms-drawer__list">
												{entry.children.map((c) => (
													<li>
														<a class="ms-drawer__link" href={c.href}>
															{c.label}
														</a>
													</li>
												))}
											</ul>
										</div>
									</li>
								) : (
									<li>
										<a class="ms-drawer__link" href={entry.href}>
											{entry.label}
										</a>
									</li>
								),
							)}
						</ul>
					</div>
				</div>
			);
		})
	}
	</div>
</header>

<script>
	function initMainSiteHeader() {
		const nav = document.querySelector<HTMLElement>('[data-ms-nav]');
		if (!nav) return;
		const toggler = nav.querySelector<HTMLButtonElement>('[data-ms-toggler]');
		const collapse = nav.querySelector<HTMLElement>('[data-ms-collapse]');
		const backdrop = document.querySelector<HTMLElement>('[data-ms-backdrop]');
		let openDrawer: HTMLElement | null = null;
		let returnFocus: HTMLElement | null = null;

		toggler?.addEventListener('click', () => {
			const open = toggler.getAttribute('aria-expanded') !== 'true';
			toggler.setAttribute('aria-expanded', String(open));
			collapse?.classList.toggle('is-open', open);
		});

		const close = () => {
			if (!openDrawer) return;
			openDrawer.classList.remove('is-open');
			backdrop?.classList.remove('is-open');
			document.documentElement.classList.remove('ms-lock');
			openDrawer = null;
			returnFocus?.focus({ preventScroll: true });
		};

		document.querySelectorAll<HTMLButtonElement>('[data-ms-drawer-open]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const drawer = document.getElementById(btn.dataset.msDrawerOpen!);
				if (!drawer) return;
				close();
				returnFocus = btn;
				openDrawer = drawer;
				drawer.classList.add('is-open');
				backdrop?.classList.add('is-open');
				document.documentElement.classList.add('ms-lock');
				drawer.querySelector<HTMLElement>('[data-ms-drawer-close]')?.focus({ preventScroll: true });
			});
		});
		document.querySelectorAll('[data-ms-drawer-close]').forEach((b) => b.addEventListener('click', close));
		backdrop?.addEventListener('click', close);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') close();
		});

		document.querySelectorAll<HTMLButtonElement>('[data-ms-group]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const sub = document.getElementById(btn.getAttribute('aria-controls')!);
				const open = btn.getAttribute('aria-expanded') !== 'true';
				btn.setAttribute('aria-expanded', String(open));
				if (sub) sub.hidden = !open;
			});
		});
	}

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initMainSiteHeader);
	else initMainSiteHeader();
</script>

<style>
	/* --- Bar ------------------------------------------------------------- */
	.ms-nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1030;
		padding-block: 21px;
		background-color: rgba(41, 37, 58, 0.95);
		max-height: 100vh;
		overflow-y: auto;
	}
	.ms-nav__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
	}
	.ms-nav__logo {
		display: block;
		width: 150px;
		height: 39px;
		line-height: 0;
	}
	.ms-nav__logo img {
		width: 150px;
		height: 38px;
	}

	/* Hamburger (below 1200px). */
	.ms-nav__toggler {
		padding: 5.25px 15.75px;
		font-size: 26.25px;
		line-height: 1;
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 5.25px;
		color: rgba(255, 255, 255, 0.55);
		cursor: pointer;
	}
	.ms-nav__toggler:focus-visible {
		outline: 0;
		box-shadow: 0 0 0 5.25px;
	}
	.ms-nav__toggler-icon {
		display: inline-block;
		width: 1.5em;
		height: 1.5em;
		vertical-align: middle;
		background: no-repeat 50% / 100%
			url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3E%3Cpath stroke='rgba(255, 255, 255, 0.55)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3E%3C/svg%3E");
	}

	.ms-nav__collapse {
		display: none;
		flex-basis: 100%;
		flex-grow: 1;
		align-items: center;
		max-height: calc(100vh - 72px);
	}
	.ms-nav__collapse.is-open {
		display: flex;
	}
	.ms-nav__list {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		flex: 1 1 auto;
		margin: 0;
		padding: 1.89px;
		list-style: none;
		font-size: 20px;
		line-height: 30px;
	}
	.ms-nav__item {
		margin: 0;
		font-size: medium;
	}

	.ms-nav__link {
		display: flex;
		gap: 10px;
		align-items: baseline;
		padding: 10.5px 0;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 16px;
		font-weight: 500;
		line-height: 24px;
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		background: none;
		border: 0;
		cursor: pointer;
	}
	.ms-nav__link--toggle::after {
		content: '⌄';
		color: rgba(255, 255, 255, 0.55);
		line-height: 15px;
	}

	.ms-nav__btn {
		display: block;
		width: fit-content;
		margin-block: 31.5px;
		padding: 10px 30px;
		border-radius: 105px;
		background-color: var(--ms-violet);
		opacity: 0.8;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 16px;
		line-height: 24px;
		color: #fff;
		text-decoration: none;
	}

	.ms-nav__socials {
		display: flex;
		align-items: center;
		font-size: 20px;
		line-height: 30px;
	}
	.ms-nav__social {
		display: block;
		padding: 0 10.5px;
		line-height: 30px;
		color: #fff;
		text-decoration: none;
	}
	.ms-nav__social i::before {
		width: 1em;
		margin: 0;
	}

	@media (min-width: 1200px) {
		.ms-nav {
			background-color: rgba(41, 37, 58, 0.85);
			overflow-y: visible;
		}
		.ms-nav__inner {
			flex-wrap: nowrap;
		}
		.ms-nav__toggler {
			display: none;
		}
		.ms-nav__collapse {
			display: flex;
			flex-basis: auto;
		}
		/* Fixed row height like the live bar: the contact pill overhangs it,
		   so the bar's height comes from the logo (39px) alone. */
		.ms-nav__list {
			flex-direction: row;
			height: 33.75px;
		}
		.ms-nav__item {
			margin-inline: 10px;
		}
		.ms-nav__link {
			padding: 0;
		}
		.ms-nav__btn {
			margin-block: 0;
			line-height: 20px;
		}
	}
	@media (min-width: 1199px) and (max-width: 1280px) {
		.ms-nav__item,
		.ms-nav__link,
		.ms-nav__btn {
			font-size: 13px;
		}
	}
	@media (min-width: 1401px) {
		.ms-nav__item {
			margin-inline: 16px;
		}
	}
	@media (min-width: 1200px) {
		/* The live site's social group isn't a .nav-item, so it has no side margins. */
		.ms-nav__item.ms-nav__socials {
			margin-inline: 0;
		}
	}
	@media (min-width: 1600px) {
		.ms-nav__logo {
			margin-left: 63px;
		}
	}

	/* --- Slide-out drawers ("offcanvas") --------------------------------- */
	.ms-layer {
		position: fixed;
		inset: 0;
		z-index: 1040;
		overflow: hidden;
		overflow: clip; /* clip, not hidden: a hidden box can still be scrolled by focus() */
		pointer-events: none;
	}
	.ms-drawer {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		pointer-events: auto;
		display: flex;
		flex-direction: column;
		width: 400px;
		max-width: 100%;
		background-color: var(--ms-nav-bg);
		background-clip: padding-box;
		border-left: 1px solid rgba(33, 37, 41, 0.2);
		transform: translateX(100%);
		visibility: hidden;
		transition:
			transform 0.3s ease-in-out,
			visibility 0s linear 0.3s;
		font-size: 16px;
		line-height: 24px;
	}
	.ms-drawer.is-open {
		transform: none;
		visibility: visible;
		transition: transform 0.3s ease-in-out;
	}
	.ms-drawer__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 21px;
	}
	.ms-drawer__heading {
		margin: 0;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 36.75px;
		font-weight: 600;
		line-height: 1.2;
		color: rgba(255, 255, 255, 0.8);
	}
	.ms-drawer__close {
		box-sizing: content-box;
		width: 16px;
		height: 16px;
		margin: -10.5px -10.5px -10.5px auto;
		padding: 10.5px;
		border: 0;
		border-radius: 5.25px;
		opacity: 0.5;
		cursor: pointer;
		background: transparent center / 16px auto no-repeat
			url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23fff'%3E%3Cpath d='M.293.293a1 1 0 0 1 1.414 0L8 6.586 14.293.293a1 1 0 1 1 1.414 1.414L9.414 8l6.293 6.293a1 1 0 0 1-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 0 1-1.414-1.414L6.586 8 .293 1.707a1 1 0 0 1 0-1.414z'/%3E%3C/svg%3E");
	}
	.ms-drawer__close:hover {
		opacity: 0.75;
	}
	.ms-drawer__body {
		flex-grow: 1;
		overflow-y: auto;
		padding: 0 21px;
	}
	.ms-drawer__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.ms-drawer__link,
	.ms-drawer__group {
		display: block;
		padding: 10.5px;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 16px;
		font-weight: 400;
		line-height: 24px;
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
	}
	.ms-drawer__group {
		display: flex;
		align-items: center;
		background: transparent;
		border: 0;
		box-shadow: inset 0 -1px 0 rgba(33, 37, 41, 0.125);
		text-align: left;
		cursor: pointer;
	}
	.ms-drawer__group::after {
		content: '';
		flex-shrink: 0;
		width: 26.25px;
		height: 26.25px;
		margin-left: 21px;
		background: no-repeat center / 90%
			url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23FFFFFFCC' stroke='%23FFFFFFCC'%3E%3Cpath fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/%3E%3C/svg%3E");
		transition: transform 0.2s ease-in-out;
	}
	.ms-drawer__group[aria-expanded='true']::after {
		transform: rotate(-90deg);
	}
	.ms-drawer__sub {
		padding-inline: 21px;
	}

	.ms-backdrop {
		position: absolute;
		inset: 0;
		background-color: #212529;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s linear;
	}
	.ms-backdrop.is-open {
		opacity: 0.5;
		pointer-events: auto;
	}

	:global(html.ms-lock) {
		overflow: hidden;
	}

	@media (prefers-reduced-motion: reduce) {
		.ms-drawer,
		.ms-drawer.is-open,
		.ms-backdrop,
		.ms-drawer__group::after {
			transition: none;
		}
	}
</style>

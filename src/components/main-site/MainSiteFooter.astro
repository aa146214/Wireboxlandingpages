---
/**
 * Footer of the main wirebox.co.uk site, rebuilt to match it: the "have a
 * project in mind?" enquiry form, the offices, socials, award logos, partner
 * and service links, and the white legal bar.
 *
 * Content comes from the Storyblok `main_site_footer` blok (headings, offices,
 * socials, credential logos, link lists, legal links, copyright); every field
 * falls back to the code defaults (src/lib/main-site.ts).
 *
 * The live form is Contact Form 7; this one posts to /api/lead (source
 * "footer") like the app's other lead forms, so enquiries arrive by email.
 */
import '../../styles/main-site.css';
import { storyblokEditable } from '@storyblok/astro';
import { mainFooter, telHref } from '../../lib/main-site';

const { blok } = Astro.props;
const f = mainFooter(blok);
// The live heading breaks before "can trust_" on very wide screens only.
const [credA, credB] = f.credentialsHeading.includes(' can trust')
	? [f.credentialsHeading.slice(0, f.credentialsHeading.indexOf(' can trust')), f.credentialsHeading.slice(f.credentialsHeading.indexOf(' can trust') + 1)]
	: [f.credentialsHeading, ''];
---

<footer class="ms-footer" {...(blok ? storyblokEditable(blok) : {})}>
	<div class="ms-container">
		<div class="ms-footer__row">
			<div class="ms-footer__col ms-footer__col--form">
				<h3 class="ms-footer__heading ms-footer__heading--form">{f.formHeading}</h3>
				<form class="ms-footer__form" action="/api/lead" method="post" data-lead novalidate>
					<input type="hidden" name="source" value="footer" />
					<input type="hidden" name="page" value="" />
					<input class="lead-hp" type="text" name="hp_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
					<div class="ms-footer__pair ms-footer__pair--first">
						<input class="ms-field" type="text" name="name" placeholder="Name" aria-label="Name" maxlength="400" required />
						<input class="ms-field" type="text" name="company" placeholder="Company" aria-label="Company" maxlength="400" required />
					</div>
					<div class="ms-footer__pair">
						<input class="ms-field" type="email" name="email" placeholder="Email" aria-label="Email" maxlength="400" required />
						<input class="ms-field" type="tel" name="phone" placeholder="Phone" aria-label="Phone" maxlength="400" required />
					</div>
					<div class="ms-footer__message">
						<textarea class="ms-field" name="message" rows="5" maxlength="2000" placeholder="Message" aria-label="Message" required></textarea>
					</div>
					<button class="ms-footer__submit" type="submit">
						{f.formButton} <i class="icon-arrow-right ms-footer__arrow" aria-hidden="true"></i>
					</button>
					<p class="ms-footer__status" data-lead-status aria-live="polite"></p>
				</form>
			</div>

			<div class="ms-footer__col">
				<h3 class="ms-footer__heading">{f.contactHeading}</h3>
				{
					f.offices.map((o, i) => (
						<>
							{i > 0 && <br />}
							<h5 class:list={['ms-footer__office', `ms-footer__office--${o.tone}`]}>{o.name}</h5>
							<p class="ms-footer__address">
								<small>
									{o.address
										.split(/\r?\n/)
										.filter(Boolean)
										.map((line, j) => (
											<>
												{j > 0 && <br />}
												{line}
											</>
										))}
								</small>
							</p>
							<div class="ms-footer__contact">
								{o.phone && (
									<a class="ms-footer__strong" href={telHref(o.phone)}>
										{o.phone}
									</a>
								)}
								{o.email && (
									<a class:list={['ms-footer__strong', `ms-footer__strong--${o.tone}`]} href={`mailto:${o.email}`}>
										{o.email}
									</a>
								)}
							</div>
						</>
					))
				}
				<br />
				<div class="ms-footer__social">
					{
						f.socials.map((s) => (
							<a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
								<i class={s.icon} aria-hidden="true" />
							</a>
						))
					}
				</div>
			</div>

			<div class="ms-footer__col">
				<h3 class="ms-footer__heading">
					{credA}
					{credB && <br class="ms-footer__xxl-br" />}
					{credB && ` ${credB}`}
				</h3>
				<div class="ms-footer__logos">
					{
						f.credentials.map((c) => (
							<div>
								{c.link ? (
									<a href={c.link} target="_blank" rel="noopener">
										<img src={c.src} alt={c.alt} width="139" height="174" loading="lazy" />
									</a>
								) : (
									<img src={c.src} alt={c.alt} width="139" height="174" loading="lazy" />
								)}
							</div>
						))
					}
				</div>
				<div class="ms-footer__links">
					{f.links.map((l) => <a href={l.href}>{l.label}</a>)}
					{
						f.services.length > 0 && (
							<div class="ms-footer__services">
								<h5 class="ms-footer__services-heading">{f.servicesHeading}</h5>
								{f.services.map((l) => (
									<a href={l.href}>{l.label}</a>
								))}
							</div>
						)
					}
				</div>
			</div>
		</div>
	</div>

	<div class="ms-footer__bottom">
		<div class="ms-container">
			<div class="ms-footer__bottom-row">
				<div class="ms-footer__legal">
					{
						f.legal.map((l, i) => (
							<>
								{i > 0 && ' | '}
								<a href={l.href}>{l.label}</a>
							</>
						))
					}
				</div>
				<div class="ms-footer__copyright">{f.copyright}</div>
			</div>
		</div>
	</div>
</footer>

<script>
	import '../../scripts/lead-form';
</script>

<style>
	.ms-footer {
		background-color: #161026;
		font-family: 'Lato', sans-serif;
		font-size: 21px;
		line-height: 1.5;
		color: #fff;
	}
	.ms-footer a {
		text-decoration: none;
	}

	.ms-footer__row {
		display: flex;
		flex-wrap: wrap;
		padding-block: 63px;
		margin-inline: -15.75px;
	}
	.ms-footer__col {
		flex: 0 0 100%;
		padding-inline: 15.75px;
		text-align: center;
	}
	.ms-footer__col + .ms-footer__col {
		margin-top: 31.5px;
	}

	.ms-footer__heading {
		margin: 0 0 63px;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: calc(26.825px + 0.3288vw);
		font-weight: 600;
		line-height: 1.2;
		color: #fff;
	}
	.ms-footer__heading--form {
		padding-bottom: 31.5px;
	}
	.ms-footer__xxl-br {
		display: none;
	}

	/* --- Enquiry form ---------------------------------------------------- */
	.ms-footer__pair {
		display: flex;
		margin-block: 15.75px;
	}
	.ms-footer__pair--first {
		margin-block: 0;
	}
	.ms-footer__pair > .ms-field {
		width: 50%;
		min-width: 0;
	}
	.ms-footer__pair > .ms-field:first-child {
		margin-right: 63px;
	}
	.ms-footer__pair > .ms-field:last-child {
		margin-left: 10.5px;
	}
	.ms-footer__message {
		margin-block: 15.75px;
	}
	.ms-field {
		display: block;
		width: 100%;
		padding: 7.875px 0;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 21px;
		font-weight: 400;
		line-height: 1.5;
		color: #fff;
		background-color: transparent;
		border: 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.56);
		border-radius: 0;
		appearance: none;
		transition: border-color 0.15s ease-in-out;
	}
	.ms-field::placeholder {
		color: #6c757d;
		opacity: 1;
	}
	.ms-field:focus {
		outline: 0;
		border-color: #6c35fb;
	}
	textarea.ms-field {
		resize: vertical;
	}

	.ms-footer__submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-top: 21px;
		padding: 12px 31.5px;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 19.992px;
		font-weight: 600;
		line-height: 1.5;
		color: #2a0c67;
		background-color: #e78cc9;
		border: 0;
		border-radius: 1050px;
		cursor: pointer;
		transition: all 0.4s ease-in-out;
	}
	.ms-footer__submit:hover,
	.ms-footer__submit:focus-visible {
		color: #fff;
		background-color: #e60775;
	}
	.ms-footer__submit:disabled {
		opacity: 0.65;
		cursor: default;
	}
	.ms-footer__arrow {
		display: inline-block;
		margin-left: 15px;
		font-size: 6px;
		vertical-align: middle;
	}
	.ms-footer__arrow::before {
		margin: 0;
		width: auto;
	}
	.ms-footer__status {
		margin: 15.75px 0 0;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 16px;
		color: rgba(255, 255, 255, 0.8);
	}
	.ms-footer__status:empty {
		display: none;
	}
	.ms-footer__status[data-state='error'] {
		color: #e78cc9;
	}

	/* --- Offices --------------------------------------------------------- */
	.ms-footer__office {
		margin: 0;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 26.25px;
		font-weight: 600;
		line-height: 1.2;
	}
	.ms-footer__office--green {
		color: #8ce7aa;
	}
	.ms-footer__office--yellow {
		color: #e7e78c;
	}
	.ms-footer__address {
		margin: 0 0 21px;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-weight: 400;
		color: #fff;
		opacity: 0.8;
	}
	.ms-footer__address small {
		font-size: 0.875em;
	}
	.ms-footer__contact {
		display: flex;
		flex-direction: column;
	}
	.ms-footer__strong {
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-weight: 600;
		color: #fff;
	}
	.ms-footer__strong--green {
		color: #8ce7aa;
	}
	.ms-footer__strong--yellow {
		color: #e7e78c;
	}
	.ms-footer__social {
		display: flex;
		justify-content: center;
		line-height: 31.5px;
	}
	.ms-footer__social a {
		padding-right: 10.5px;
		color: #fff;
	}
	.ms-footer__social i::before {
		margin: 0;
	}

	/* --- Credentials ------------------------------------------------------ */
	.ms-footer__logos {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		column-gap: 31.5px;
		align-items: start;
	}
	.ms-footer__logos img {
		display: block;
		max-width: 100%;
		height: auto;
		margin-inline: auto;
	}
	.ms-footer__links {
		display: flex;
		flex-direction: column;
		margin-top: 24px;
	}
	.ms-footer__links a {
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 19.005px;
		line-height: 1.5;
		color: #fff;
	}
	.ms-footer__links a:hover {
		text-decoration: underline;
	}
	.ms-footer__services {
		display: flex;
		flex-direction: column;
		padding-top: 21px;
	}
	.ms-footer__services-heading {
		margin: 0 0 10.5px;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 26.25px;
		font-weight: 500;
		line-height: 1.2;
		color: #fff;
		text-decoration: underline;
	}

	/* --- Legal bar ------------------------------------------------------- */
	.ms-footer__bottom {
		background-color: #fff;
		color: #161026;
	}
	.ms-footer__bottom-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		margin-block: 10.5px;
		padding-block: 31.5px;
		font-size: 16.8px;
		line-height: 1.5;
	}
	.ms-footer__legal {
		flex: 0 0 100%;
		margin-bottom: 15.75px;
	}
	.ms-footer__copyright {
		flex: 0 0 100%;
	}
	.ms-footer__bottom a {
		font-family: 'Inter Variable', 'Inter', sans-serif;
		color: #161026;
	}
	.ms-footer__bottom a:hover {
		text-decoration: underline;
	}

	@media (min-width: 768px) {
		.ms-footer__pair--first {
			margin-block: 15.75px;
		}
		.ms-footer__legal {
			flex-basis: 58.333%;
			margin-bottom: 0;
		}
		.ms-footer__copyright {
			flex-basis: 33.333%;
		}
	}
	@media (min-width: 992px) {
		.ms-footer__col {
			flex-basis: 25%;
			text-align: left;
		}
		.ms-footer__col--form {
			flex-basis: 50%;
		}
		.ms-footer__col + .ms-footer__col {
			margin-top: 0;
		}
		.ms-footer__pair,
		.ms-footer__message {
			margin-block: 31.5px;
		}
		.ms-footer__social {
			justify-content: flex-start;
		}
		.ms-footer__logos {
			display: flex;
			column-gap: 0;
			margin-inline: -15.75px;
		}
		.ms-footer__logos > * {
			flex: 0 0 33.333%;
			padding-inline: 15.75px;
		}
		.ms-footer__logos img {
			width: min(8vw, 138.81px);
			margin-inline: 0;
		}
		.ms-footer__links {
			margin-top: 55px;
		}
	}
	@media (min-width: 1200px) {
		.ms-footer__heading {
			font-size: 32.004px;
		}
	}
	@media (min-width: 1400px) {
		.ms-footer__xxl-br {
			display: block;
		}
	}
</style>

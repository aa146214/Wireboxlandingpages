---
/**
 * Footer of the main wirebox.co.uk site, rebuilt to match it: the "have a
 * project in mind?" enquiry form, both offices, socials, award logos, partner
 * and service links, and the white legal bar.
 *
 * The live form is Contact Form 7; this one posts to /api/lead (source
 * "footer") like the app's other lead forms, so enquiries arrive by email.
 */
import '../../styles/main-site.css';
import { MAIN_SOCIALS, MAIN_FOOTER_LEGAL, MAIN_FOOTER_LINKS, MAIN_FOOTER_SERVICES, MAIN_SITE } from '../../data/main-site-nav';
---

<footer class="ms-footer">
	<div class="ms-container">
		<div class="ms-footer__row">
			<div class="ms-footer__col ms-footer__col--form">
				<h3 class="ms-footer__heading ms-footer__heading--form">
					have a project in mind? reach out to our team, so we can understand more_
				</h3>
				<form class="ms-footer__form" action="/api/lead" method="post" data-lead novalidate>
					<input type="hidden" name="source" value="footer" />
					<input type="hidden" name="page" value="" />
					<input class="lead-hp" type="text" name="hp_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
					<div class="ms-footer__pair ms-footer__pair--first">
						<input class="ms-field" type="text" name="name" placeholder="Name" aria-label="Name" maxlength="400" required />
						<input class="ms-field" type="text" name="company" placeholder="Company" aria-label="Company" maxlength="400" required />
					</div>
					<div class="ms-footer__pair">
						<input class="ms-field" type="email" name="email" placeholder="Email" aria-label="Email" maxlength="400" required />
						<input class="ms-field" type="tel" name="phone" placeholder="Phone" aria-label="Phone" maxlength="400" required />
					</div>
					<div class="ms-footer__message">
						<textarea class="ms-field" name="message" rows="5" maxlength="2000" placeholder="Message" aria-label="Message" required></textarea>
					</div>
					<button class="ms-footer__submit" type="submit">
						let's talk <i class="icon-arrow-right ms-footer__arrow" aria-hidden="true"></i>
					</button>
					<p class="ms-footer__status" data-lead-status aria-live="polite"></p>
				</form>
			</div>

			<div class="ms-footer__col">
				<h3 class="ms-footer__heading">get in touch_</h3>

				<h5 class="ms-footer__office ms-footer__office--green">Watford</h5>
				<p class="ms-footer__address">
					<small>
						Leavesden Lodge,<br />
						Unit 1 Copsewood Lodge,<br />
						1A Copsewood Road, Watford<br />
						Hertfordshire, WD24 5DY
					</small>
				</p>
				<div class="ms-footer__contact">
					<a class="ms-footer__strong" href="tel:+442079935485">+44 (0) 207 993 5485</a>
					<a class="ms-footer__strong ms-footer__strong--green" href="mailto:hello@wirebox.co.uk">hello@wirebox.co.uk</a>
				</div>
				<br />
				<h5 class="ms-footer__office ms-footer__office--yellow">Milton Keynes</h5>
				<p class="ms-footer__address">
					<small>
						3rd Floor Elder House West,<br />
						Elder Gate, Milton Keynes<br />
						MK9 1LR
					</small>
				</p>
				<div class="ms-footer__contact">
					<a class="ms-footer__strong" href="tel:+441908110420">+44 (0) 1908 11 04 20</a>
					<a class="ms-footer__strong ms-footer__strong--yellow" href="mailto:hi@wirebox.co.uk">hi@wirebox.co.uk</a>
				</div>
				<br />
				<div class="ms-footer__social">
					{
						MAIN_SOCIALS.map((s) => (
							<a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
								<i class={`${s.icon}`} aria-hidden="true" />
							</a>
						))
					}
				</div>
			</div>

			<div class="ms-footer__col">
				<h3 class="ms-footer__heading">credentials you <br class="ms-footer__xxl-br" />can trust_</h3>
				<div class="ms-footer__logos">
					<div>
						<img src="/main-site/biz4biz-awards-2025-winner.png" alt="Biz4Biz Awards 2025" width="143" height="174" loading="lazy" />
					</div>
					<div>
						<img src="/main-site/sme-herts-2024-gold-winner.jpg" alt="Hertfordshire SME Business Awards 2024" width="139" height="174" loading="lazy" />
					</div>
					<div>
						<a href={`${MAIN_SITE}/our-commitment-to-the-watford-business-pledge/`} target="_blank" rel="noopener">
							<img src="/main-site/watford-pledge-member.png" alt="Watford Business Pledge member" width="139" height="174" loading="lazy" />
						</a>
					</div>
				</div>
				<div class="ms-footer__links">
					{MAIN_FOOTER_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
					<div class="ms-footer__services">
						<h5 class="ms-footer__services-heading">Services</h5>
						{MAIN_FOOTER_SERVICES.map((l) => <a href={l.href}>{l.label}</a>)}
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="ms-footer__bottom">
		<div class="ms-container">
			<div class="ms-footer__bottom-row">
				<div class="ms-footer__legal">
					{
						MAIN_FOOTER_LEGAL.map((l, i) => (
							<>
								{i > 0 && ' | '}
								<a href={l.href}>{l.label}</a>
							</>
						))
					}
				</div>
				<div class="ms-footer__copyright">
					Copyright &copy; Wirebox Ltd | Registered in England and Wales, registered number 07887947
				</div>
			</div>
		</div>
	</div>
</footer>

<script>
	import '../../scripts/lead-form';
</script>

<style>
	.ms-footer {
		background-color: #161026;
		font-family: 'Lato', sans-serif;
		font-size: 21px;
		line-height: 1.5;
		color: #fff;
	}
	.ms-footer a {
		text-decoration: none;
	}

	.ms-footer__row {
		display: flex;
		flex-wrap: wrap;
		padding-block: 63px;
		margin-inline: -15.75px;
	}
	.ms-footer__col {
		flex: 0 0 100%;
		padding-inline: 15.75px;
		text-align: center;
	}
	.ms-footer__col + .ms-footer__col {
		margin-top: 31.5px;
	}

	.ms-footer__heading {
		margin: 0 0 63px;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: calc(26.825px + 0.3288vw);
		font-weight: 600;
		line-height: 1.2;
		color: #fff;
	}
	.ms-footer__heading--form {
		padding-bottom: 31.5px;
	}
	.ms-footer__xxl-br {
		display: none;
	}

	/* --- Enquiry form ---------------------------------------------------- */
	.ms-footer__pair {
		display: flex;
		margin-block: 15.75px;
	}
	.ms-footer__pair--first {
		margin-block: 0;
	}
	.ms-footer__pair > .ms-field {
		width: 50%;
		min-width: 0;
	}
	.ms-footer__pair > .ms-field:first-child {
		margin-right: 63px;
	}
	.ms-footer__pair > .ms-field:last-child {
		margin-left: 10.5px;
	}
	.ms-footer__message {
		margin-block: 15.75px;
	}
	.ms-field {
		display: block;
		width: 100%;
		padding: 7.875px 0;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 21px;
		font-weight: 400;
		line-height: 1.5;
		color: #fff;
		background-color: transparent;
		border: 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.56);
		border-radius: 0;
		appearance: none;
		transition: border-color 0.15s ease-in-out;
	}
	.ms-field::placeholder {
		color: #6c757d;
		opacity: 1;
	}
	.ms-field:focus {
		outline: 0;
		border-color: #6c35fb;
	}
	textarea.ms-field {
		resize: vertical;
	}

	.ms-footer__submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-top: 21px;
		padding: 12px 31.5px;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 19.992px;
		font-weight: 600;
		line-height: 1.5;
		color: #2a0c67;
		background-color: #e78cc9;
		border: 0;
		border-radius: 1050px;
		cursor: pointer;
		transition: all 0.4s ease-in-out;
	}
	.ms-footer__submit:hover,
	.ms-footer__submit:focus-visible {
		color: #fff;
		background-color: #e60775;
	}
	.ms-footer__submit:disabled {
		opacity: 0.65;
		cursor: default;
	}
	.ms-footer__arrow {
		display: inline-block;
		margin-left: 15px;
		font-size: 6px;
		vertical-align: middle;
	}
	.ms-footer__arrow::before {
		margin: 0;
		width: auto;
	}
	.ms-footer__status {
		margin: 15.75px 0 0;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 16px;
		color: rgba(255, 255, 255, 0.8);
	}
	.ms-footer__status:empty {
		display: none;
	}
	.ms-footer__status[data-state='error'] {
		color: #e78cc9;
	}

	/* --- Offices --------------------------------------------------------- */
	.ms-footer__office {
		margin: 0;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 26.25px;
		font-weight: 600;
		line-height: 1.2;
	}
	.ms-footer__office--green {
		color: #8ce7aa;
	}
	.ms-footer__office--yellow {
		color: #e7e78c;
	}
	.ms-footer__address {
		margin: 0 0 21px;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-weight: 400;
		color: #fff;
		opacity: 0.8;
	}
	.ms-footer__address small {
		font-size: 0.875em;
	}
	.ms-footer__contact {
		display: flex;
		flex-direction: column;
	}
	.ms-footer__strong {
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-weight: 600;
		color: #fff;
	}
	.ms-footer__strong--green {
		color: #8ce7aa;
	}
	.ms-footer__strong--yellow {
		color: #e7e78c;
	}
	.ms-footer__social {
		display: flex;
		justify-content: center;
		line-height: 31.5px;
	}
	.ms-footer__social a {
		padding-right: 10.5px;
		color: #fff;
	}
	.ms-footer__social i::before {
		margin: 0;
	}

	/* --- Credentials ------------------------------------------------------ */
	.ms-footer__logos {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		column-gap: 31.5px;
		align-items: start;
	}
	.ms-footer__logos img {
		display: block;
		max-width: 100%;
		height: auto;
		margin-inline: auto;
	}
	.ms-footer__links {
		display: flex;
		flex-direction: column;
		margin-top: 24px;
	}
	.ms-footer__links a {
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 19.005px;
		line-height: 1.5;
		color: #fff;
	}
	.ms-footer__links a:hover {
		text-decoration: underline;
	}
	.ms-footer__services {
		display: flex;
		flex-direction: column;
		padding-top: 21px;
	}
	.ms-footer__services-heading {
		margin: 0 0 10.5px;
		font-family: 'Inter Variable', 'Inter', sans-serif;
		font-size: 26.25px;
		font-weight: 500;
		line-height: 1.2;
		color: #fff;
		text-decoration: underline;
	}

	/* --- Legal bar ------------------------------------------------------- */
	.ms-footer__bottom {
		background-color: #fff;
		color: #161026;
	}
	.ms-footer__bottom-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		margin-block: 10.5px;
		padding-block: 31.5px;
		font-size: 16.8px;
		line-height: 1.5;
	}
	.ms-footer__legal {
		flex: 0 0 100%;
		margin-bottom: 15.75px;
	}
	.ms-footer__copyright {
		flex: 0 0 100%;
	}
	.ms-footer__bottom a {
		font-family: 'Inter Variable', 'Inter', sans-serif;
		color: #161026;
	}
	.ms-footer__bottom a:hover {
		text-decoration: underline;
	}

	@media (min-width: 768px) {
		.ms-footer__pair--first {
			margin-block: 15.75px;
		}
		.ms-footer__legal {
			flex-basis: 58.333%;
			margin-bottom: 0;
		}
		.ms-footer__copyright {
			flex-basis: 33.333%;
		}
	}
	@media (min-width: 992px) {
		.ms-footer__col {
			flex-basis: 25%;
			text-align: left;
		}
		.ms-footer__col--form {
			flex-basis: 50%;
		}
		.ms-footer__col + .ms-footer__col {
			margin-top: 0;
		}
		.ms-footer__pair,
		.ms-footer__message {
			margin-block: 31.5px;
		}
		.ms-footer__social {
			justify-content: flex-start;
		}
		.ms-footer__logos {
			display: flex;
			column-gap: 0;
			margin-inline: -15.75px;
		}
		.ms-footer__logos > * {
			flex: 0 0 33.333%;
			padding-inline: 15.75px;
		}
		.ms-footer__logos img {
			width: min(8vw, 138.81px);
			margin-inline: 0;
		}
		.ms-footer__links {
			margin-top: 55px;
		}
	}
	@media (min-width: 1200px) {
		.ms-footer__heading {
			font-size: 32.004px;
		}
	}
	@media (min-width: 1400px) {
		.ms-footer__xxl-br {
			display: block;
		}
	}
</style>

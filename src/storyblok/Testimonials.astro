---
import { storyblokEditable } from '@storyblok/astro';
import { splitHighlight } from '../lib/text';

const { blok } = Astro.props;

interface Testimonial {
	quote?: string;
	name: string;
	role: string;
	/** Vimeo video id or URL — when set the card embeds a playable Vimeo player. */
	vimeo?: string;
}

const eyebrow: string = blok?.eyebrow || '';
const heading: string = blok?.heading || 'What our clients say_';
const accent: string = blok?.heading_accent || '';
const items: Testimonial[] = blok?.items ?? [];
const vimeoId = (v?: string) => (v ? (String(v).match(/\d{6,}/)?.[0] ?? '') : '');
const h = splitHighlight(heading, accent);
---

<section class="testimonials" {...storyblokEditable(blok)}>
	<div class="container testimonials__head">
		{eyebrow && <p class="testimonials__eyebrow category">{eyebrow}</p>}
		<h2 class="testimonials__heading section-heading">{h.pre}<span class="testimonials__hl">{h.mid}</span>{h.post}</h2>
	</div>

	<div class="testimonials__viewport" data-carousel>
		<ul class="testimonials__track" role="list">
			{
				items.map((t) => {
					const id = vimeoId(t.vimeo);
					return id ? (
						<li class="t-card t-card--video">
							<div class="t-card__video">
								<iframe
									src={`https://player.vimeo.com/video/${id}`}
									title={`Video review from ${t.name}`}
									loading="lazy"
									frameborder="0"
									allow="autoplay; fullscreen; picture-in-picture"
									allowfullscreen
								/>
							</div>
							<footer class="t-card__author">
								<p class="t-card__name">{t.name}</p>
								<p class="t-card__role">{t.role}</p>
							</footer>
						</li>
					) : (
						<li class="t-card">
							<blockquote class="t-card__quote">{t.quote}</blockquote>
							<span class="t-card__dash" aria-hidden="true" />
							<footer class="t-card__author">
								<p class="t-card__name">{t.name}</p>
								<p class="t-card__role">{t.role}</p>
							</footer>
						</li>
					);
				})
			}
		</ul>
	</div>

	<div class="container">
		<div class="testimonials__dots" role="tablist" aria-label="Testimonials">
			<button type="button" class="testimonials__dot" data-page="0" aria-label="Page 1"></button>
			<button type="button" class="testimonials__dot" data-page="1" aria-label="Page 2"></button>
			<button type="button" class="testimonials__dot" data-page="2" aria-label="Page 3"></button>
		</div>
	</div>
</section>

<style>
	.testimonials {
		--t-card-w: clamp(280px, 82vw, 404px);
		background: var(--color-light-lavender); /* Figma: Light Lavender #cabbe7 */
		padding-block: var(--section-py-sm);
		overflow: hidden;
	}
	.testimonials__head {
		text-align: center;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}
	.testimonials__eyebrow {
		color: var(--color-dark-blue); /* Figma: Dark Blue eyebrow */
		margin-bottom: 1rem;
	}
	.testimonials__heading {
		color: var(--color-dark-blue);
	}
	.testimonials__hl {
		color: var(--color-fuchsia);
	}

	.testimonials__viewport {
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		scroll-padding-inline: var(--container-pad);
	}
	.testimonials__viewport::-webkit-scrollbar {
		display: none;
	}
	.testimonials__track {
		display: flex;
		gap: clamp(20px, 2.5vw, 48px);
		margin: 0;
		padding: 1rem var(--container-pad);
		width: max-content;
	}

	.t-card {
		flex: 0 0 var(--t-card-w);
		min-height: 366px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 2rem;
		background: var(--surface-card);
		border-radius: 0;
		box-shadow: var(--shadow-card);
		scroll-snap-align: center;
	}
	.t-card--video {
		padding: 0 0 1.75rem;
		overflow: hidden;
	}

	.t-card__quote {
		margin: 0;
		font-style: italic;
		font-size: var(--fs-small);
		line-height: var(--lh-quote);
		color: var(--color-dark-blue);
	}
	.t-card__dash {
		width: 40px;
		height: 2px;
		background: var(--color-fuchsia);
		margin: 1.75rem 0 1.25rem;
	}
	.t-card__video {
		position: relative;
		align-self: stretch;
		aspect-ratio: 16 / 9;
		background: var(--color-dark-blue);
	}
	.t-card__video iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}
	.t-card--video .t-card__author {
		padding-inline: 2rem;
		margin-top: 1.5rem;
	}
	.t-card__name {
		font-size: var(--fs-small);
		font-weight: var(--fw-semibold);
		color: var(--color-headings-dark);
	}
	.t-card__role {
		font-size: var(--fs-small);
		color: var(--color-paragraph);
		margin-top: 0.15rem;
	}

	.testimonials__dots {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin-top: clamp(1.5rem, 3vw, 2.5rem);
	}
	.testimonials__dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--color-lavender);
		opacity: 0.4;
		transition: opacity var(--dur-fast) var(--ease-out);
	}
	.testimonials__dot.is-active {
		opacity: 1;
		background: var(--color-primary-blue);
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((vp) => {
		const dots = vp.parentElement?.querySelectorAll<HTMLButtonElement>(
			'.testimonials__dot'
		);
		if (!dots?.length) return;
		const pageWidth = () => vp.clientWidth * 0.8;
		dots.forEach((dot, i) => {
			dot.addEventListener('click', () => {
				const max = vp.scrollWidth - vp.clientWidth;
				vp.scrollTo({ left: (max / (dots.length - 1)) * i, behavior: 'smooth' });
			});
		});
		const sync = () => {
			const max = vp.scrollWidth - vp.clientWidth || 1;
			const active = Math.round((vp.scrollLeft / max) * (dots.length - 1));
			dots.forEach((d, i) => d.classList.toggle('is-active', i === active));
		};
		vp.addEventListener('scroll', sync, { passive: true });
		sync();
	});
</script>

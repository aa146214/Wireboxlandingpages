---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;

interface Item {
	text: string;
}

/**
 * 'dark' is the original navy bar; 'fuchsia' is the pink bar introduced with
 * the video hero. Items stay yellow in both. Defaults to 'dark'.
 */
const tone: 'dark' | 'fuchsia' = blok?.tone === 'fuchsia' ? 'fuchsia' : 'dark';

const items: Item[] = blok?.items?.length
	? blok.items
	: [
			{ text: '1-hour critical response' },
			{ text: 'No long-term contracts' },
			{ text: 'Award-winning team' },
			{ text: '5★ Google rated' },
			{ text: 'Laravel certified' },
		];
---

<section class:list={['trust-bar', `is-${tone}`]} {...storyblokEditable(blok)}>
	<ul class="trust-bar__inner container" role="list">
		{
			items.map((it) => (
				<li class="trust-bar__item">
					<span class="trust-bar__dot" aria-hidden="true" />
					{it.text}
				</li>
			))
		}
	</ul>
</section>

<style>
	.trust-bar {
		color: var(--color-light-yellow); /* Figma: items are yellow on both tones */
	}
	.trust-bar.is-dark {
		background: var(--surface-invert);
	}
	.trust-bar.is-fuchsia {
		background: var(--color-fuchsia);
	}
	.trust-bar__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem clamp(1.5rem, 4vw, 3.5rem);
		padding-block: 1.1rem;
	}
	.trust-bar__item {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-size: var(--fs-small);
		font-weight: var(--fw-medium);
		white-space: nowrap;
	}
	.trust-bar__dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-light-yellow); /* Figma: dots are yellow */
	}
</style>

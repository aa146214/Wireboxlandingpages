---
import { storyblokEditable } from '@storyblok/astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';

const { blok } = Astro.props;

interface Post {
	title: string;
	date: string;
	read_time: string;
	image?: { filename?: string } | string;
	video?: boolean;
	link?: { cached_url?: string; url?: string } | string;
}

const heading: string = blok?.heading || 'What’s going on in our world_';
const posts: Post[] = blok?.posts ?? [];
const ctaLabel: string = blok?.cta_label || 'view all posts';
const ctaLink =
	(typeof blok?.cta_link === 'string' ? blok.cta_link : blok?.cta_link?.cached_url) ||
	'/blog';
const imgSrc = (i: Post['image']) => (typeof i === 'string' ? i : i?.filename);
const resolveLink = (l: Post['link']) =>
	!l ? '#' : typeof l === 'string' ? l : l.cached_url || l.url || '#';
---

<section class="blog" {...storyblokEditable(blok)}>
	<div class="blog__inner container">
		<h2 class="blog__heading section-heading">{heading}</h2>

		<ul class="blog__grid" role="list">
			{
				posts.map((p) => (
					<li class="post-card">
						<a class="post-card__link" href={resolveLink(p.link)}>
							<div class:list={['post-card__media', { 'post-card__media--video': p.video && !imgSrc(p.image) }]}>
								{imgSrc(p.image) && <img src={imgSrc(p.image)} alt="" width="420" height="204" loading="lazy" />}
								{p.video && (
									<span class="post-card__play play-button play-button--ghost" aria-hidden="true">
										<Icon name="play" size={24} />
									</span>
								)}
							</div>
							<h3 class="post-card__title">{p.title}</h3>
							<p class="post-card__meta">{p.date}&nbsp;&nbsp;|&nbsp;&nbsp;{p.read_time}</p>
							<span class="post-card__arrow" aria-hidden="true">
								<Icon name="arrow-right" size={22} />
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<Button label={ctaLabel} link={ctaLink} variant="solid" icon="arrow-right" class="blog__cta" />
	</div>
</section>

<style>
	.blog {
		background: var(--surface-subtle);
		padding-block: var(--section-py-sm);
	}
	.blog__heading {
		color: var(--text-heading);
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}
	.blog__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1.5rem, 3vw, 2rem);
		margin: 0 0 clamp(2rem, 4vw, 3rem);
		padding: 0;
	}
	.post-card {
		background: var(--surface-card);
		border-radius: var(--radius-md);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
	}
	.post-card__link {
		display: block;
		height: 100%;
	}
	.post-card__media {
		position: relative;
		aspect-ratio: 420 / 204;
		background: var(--surface-placeholder);
		overflow: hidden;
	}
	.post-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.post-card__play {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 56px;
		height: 56px;
	}
	.post-card__title {
		font-size: var(--fs-subtitle);
		font-weight: var(--fw-semibold);
		line-height: var(--lh-h5);
		letter-spacing: var(--ls-subtitle);
		color: var(--color-headings-dark);
		padding: 1.5rem 1.5rem 0;
	}
	.post-card__meta {
		font-size: var(--fs-small);
		color: var(--color-paragraph);
		padding: 0.75rem 1.5rem 0;
	}
	.post-card__arrow {
		display: inline-flex;
		color: var(--color-primary-blue);
		padding: 0.85rem 1.5rem 1.5rem;
		transition: transform var(--dur-base) var(--ease-out);
	}
	.post-card__link:hover .post-card__arrow {
		transform: translateX(6px);
	}

	@media (max-width: 860px) {
		.blog__grid {
			grid-template-columns: 1fr;
			max-width: 480px;
		}
	}
</style>

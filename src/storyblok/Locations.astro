---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;

interface MapItem {
	filename?: string;
	alt?: string;
	link?: string;
	label?: string;
}

const maps: MapItem[] = blok?.maps?.length
	? blok.maps
	: [
			{ filename: 'https://a.storyblok.com/f/293147646055661/9ad800e8c0/map-1.png', alt: 'Map of the Milton Keynes studio location', link: 'https://maps.google.com/?q=Witan+Studio+Milton+Keynes' },
			{ filename: 'https://a.storyblok.com/f/293147646055661/c6c18caced/map-2.png', alt: 'Map of the Watford office location', link: 'https://maps.google.com/?q=Leavesden+Lodge+Watford' },
		];
---

<section class="locations" {...storyblokEditable(blok)} aria-label="Our office locations">
	<ul class="locations__grid" role="list">
		{
			maps.map((m) => (
				<li class="locations__item">
					<a href={m.link || '#'} target="_blank" rel="noopener noreferrer">
						<img src={m.filename} alt={m.alt} loading="lazy" />
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	/* Two location maps split by a white divider (per design). */
	.locations__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4px;
		margin: 0;
		padding: 0;
		background: var(--color-white);
	}
	.locations__item {
		position: relative;
		aspect-ratio: 24 / 7;
		overflow: hidden;
	}
	.locations__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 700px) {
		.locations__grid {
			grid-template-columns: 1fr;
		}
		.locations__item {
			aspect-ratio: 16 / 7;
		}
	}
</style>

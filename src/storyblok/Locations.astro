---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;

interface Place {
	label?: string;
	/** Address or "lat,lng" that Google Maps centres on. */
	query: string;
	/** Optional "open in Google Maps" link; derived from the query if omitted. */
	link?: string;
}

// Editable in Storyblok (locations.places); falls back to the two offices.
const places: Place[] = blok?.places?.length
	? blok.places
	: [
			{ label: 'Milton Keynes', query: 'Witan Studios, Milton Keynes, MK9 1EJ' },
			{ label: 'Watford', query: '1A Copsewood Road, Watford, WD24 5DY' },
		];

// Keyless Google Maps embed (no API key required).
const embedUrl = (q: string) =>
	`https://maps.google.com/maps?q=${encodeURIComponent(q)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const openUrl = (p: Place) =>
	p.link || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(p.query)}`;
---

<section class="locations" {...storyblokEditable(blok)} aria-label="Our office locations">
	<ul class="locations__grid" role="list">
		{
			places.map((p) => (
				<li class="locations__item">
					<iframe
						class="locations__map"
						src={embedUrl(p.query)}
						title={p.label ? `Map of the ${p.label} office` : 'Office location map'}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					/>
					<a class="locations__open" href={openUrl(p)} target="_blank" rel="noopener noreferrer">
						{p.label ? `Open ${p.label} in Google Maps` : 'Open in Google Maps'}
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	/* Two live Google Maps split by a white divider. */
	.locations__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4px;
		margin: 0;
		padding: 0;
		background: var(--color-white);
	}
	.locations__item {
		position: relative;
		aspect-ratio: 24 / 7;
		overflow: hidden;
	}
	.locations__map {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}
	/* Keep an accessible "open in maps" affordance without covering the map. */
	.locations__open {
		position: absolute;
		left: 1rem;
		bottom: 1rem;
		padding: 0.4rem 0.9rem;
		background: var(--color-white);
		color: var(--color-primary-blue);
		font-size: var(--fs-category);
		font-weight: var(--fw-semibold);
		box-shadow: var(--shadow-soft);
	}
	.locations__open:not(:focus) {
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		width: 1px;
		height: 1px;
		overflow: hidden;
		white-space: nowrap;
		padding: 0;
	}

	@media (max-width: 700px) {
		.locations__grid {
			grid-template-columns: 1fr;
		}
		.locations__item {
			aspect-ratio: 16 / 7;
		}
	}
</style>

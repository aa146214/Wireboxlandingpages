---
import { storyblokEditable } from '@storyblok/astro';
import {
	STEPS,
	CURRENT_VERSION_OPTIONS,
	TARGET_VERSION_OPTIONS,
	APP_SIZES,
	PHP_OPTIONS,
	TEST_COVERAGE,
	DEPENDENCY_LOAD,
	ADDONS,
} from '../data/estimator-model.mjs';

/**
 * The seven-question upgrade estimator.
 *
 * Every step is rendered server-side and hidden with [hidden]; the client
 * script only moves between them and scores the answers, so there is no
 * templating in two places and the questions are in the HTML for crawlers.
 * Scoring runs in the browser from the same module the seed and the check
 * script use — see src/data/estimator-model.mjs.
 *
 * Copy that changes per campaign (headings, the sidebar promise, the CTA) is
 * CMS-editable; the questions and weights are not, because they're the
 * commercial model and must stay in step with the reference workbook.
 */
const { blok } = Astro.props;

const eyebrow: string = blok?.eyebrow || 'Laravel upgrade estimator';
const heading: string = blok?.heading || 'Build your estimate';
const body: string =
	blok?.body ||
	"Answer seven quick questions about your application. We'll update the ballpark range for hours, cost and timeline as you go.";
const statQuestions: string = blok?.stat_questions || '7';
const statQuestionsLabel: string = blok?.stat_questions_label || 'questions';
const statTime: string = blok?.stat_time || '2 min';
const statTimeLabel: string = blok?.stat_time_label || 'to complete';

const sidebarTitle: string = blok?.sidebar_title || 'Current estimate';
const sidebarEmpty: string = blok?.sidebar_empty || 'Answer the first question to start the estimate.';
const includesTitle: string = blok?.includes_title || 'Your estimate will include';
const includesRaw: string =
	blok?.includes ||
	['Estimated cost range', 'Estimated effort in hours', 'Estimated timeline', 'Itemised work breakdown'].join('\n');
const includes: string[] = includesRaw.split(/\r?\n/).map((s: string) => s.trim()).filter(Boolean);

const noteTitle: string = blok?.note_title || 'Planning estimate, not a fixed quote';
const noteBody: string =
	blok?.note_body || "Book a short technical audit and we'll turn this into a fixed price within a few days.";
const ctaLabel: string = blok?.cta_label || 'Book a technical audit';
const ctaLink: string =
	(typeof blok?.cta_link === 'string' ? blok.cta_link : blok?.cta_link?.url || blok?.cta_link?.cached_url) || '#contact';

const updateNote: string = blok?.update_note || 'Your estimate updates after each answer.';

/** Options for each step, in the order the workbook lists them. */
const OPTIONS: Record<string, { key: string; label: string; description?: string }[]> = {
	current: CURRENT_VERSION_OPTIONS,
	target: TARGET_VERSION_OPTIONS,
	size: APP_SIZES,
	php: PHP_OPTIONS,
	tests: TEST_COVERAGE,
	deps: DEPENDENCY_LOAD,
	addons: ADDONS,
};

const pad = (n: number) => String(n).padStart(2, '0');
const total = STEPS.length;
---

<section class="ew" id="estimator" {...storyblokEditable(blok)}>
	<div class="ew__intro">
		<div class="ew__intro-inner container">
			<div class="ew__intro-copy">
				<p class="ew__eyebrow category">{eyebrow}</p>
				<h2 class="ew__heading">{heading}</h2>
				<p class="ew__body">{body}</p>
			</div>
			<ul class="ew__stats" role="list">
				<li class="ew__stat">
					<span class="ew__stat-value">{statQuestions}</span>
					<span class="ew__stat-label">{statQuestionsLabel}</span>
				</li>
				<li class="ew__stat">
					<span class="ew__stat-value is-blue">{statTime}</span>
					<span class="ew__stat-label">{statTimeLabel}</span>
				</li>
			</ul>
		</div>
	</div>

	<div class="ew__main container">
		<ol class="ew__rail" role="list" aria-label="Estimator progress">
			{
				STEPS.map((step, i) => (
					<li class:list={['ew__rail-step', { 'is-active': i === 0 }]} data-rail={step.key}>
						<span class="ew__rail-label">
							<span class="ew__rail-num">{pad(i + 1)}</span> {step.short}
						</span>
						<span class="ew__rail-bar" aria-hidden="true" />
						<span class="ew__rail-dot" aria-hidden="true" />
					</li>
				))
			}
		</ol>

		<div class="ew__grid">
			<form class="ew__card" data-estimator novalidate>
				{
					STEPS.map((step, i) => (
						<fieldset class="ew__panel" data-panel={step.key} hidden={i !== 0} aria-labelledby={`ew-q-${step.key}`}>
							{/* A <legend> always paints at the top of its fieldset, which would
							    put the question above the step counter — so the group is
							    labelled by the heading instead. */}
							<p class="ew__step-count category">
								Step {pad(i + 1)} of {pad(total)}
							</p>
							<h3 class="ew__question" id={`ew-q-${step.key}`}>{step.title}</h3>
							<p class="ew__hint">{step.hint}</p>

							<ul class="ew__options" role="list" data-options={step.key}>
								{OPTIONS[step.key].map((opt) => (
									<li>
										<label class="ew__option">
											<input
												class="ew__input"
												type={step.type === 'multi' ? 'checkbox' : 'radio'}
												name={step.key}
												value={opt.key}
											/>
											<span class="ew__marker" aria-hidden="true" />
											<span class="ew__option-text">
												<span class="ew__option-label">{opt.label}</span>
												{opt.description && <span class="ew__option-desc">{opt.description}</span>}
											</span>
										</label>
									</li>
								))}
							</ul>
							{step.key === 'target' && (
								<p class="ew__hint ew__hint--inline" data-target-note hidden>
									Only versions above the one you're on are listed.
								</p>
							)}
						</fieldset>
					))
				}

				<p class="ew__update">{updateNote}</p>

				<div class="ew__actions">
					<button class="ew__btn ew__btn--ghost" type="button" data-back hidden>Back</button>
					<button class="ew__btn ew__btn--primary" type="button" data-next disabled>
						<span data-next-label>Next</span>
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
					</button>
					<button class="ew__btn ew__btn--ghost" type="button" data-restart hidden>Start again</button>
				</div>

				<noscript>
					<p class="ew__hint">
						The estimator needs JavaScript. Call us on 0207 993 5485 and we'll size the upgrade with you
						instead.
					</p>
				</noscript>
			</form>

			<aside class="ew__side" data-side aria-live="polite">
				<p class="ew__side-title category">{sidebarTitle}</p>
				<span class="ew__side-rule" aria-hidden="true"></span>

				<p class="ew__side-empty" data-empty>{sidebarEmpty}</p>

				<div class="ew__result" data-result hidden>
					<p class="ew__result-label">Estimated cost</p>
					<p class="ew__result-cost" data-cost></p>
					<dl class="ew__result-rows">
						<div>
							<dt>Effort</dt>
							<dd data-hours></dd>
						</div>
						<div>
							<dt>Timeline</dt>
							<dd data-weeks></dd>
						</div>
					</dl>
					<ul class="ew__breakdown" role="list" data-breakdown></ul>
				</div>

				<div class="ew__includes" data-includes>
					<p class="ew__includes-title">{includesTitle}</p>
					<ol class="ew__includes-list" role="list">
						{
							includes.map((item, i) => (
								<li>
									<span class="ew__includes-num">{pad(i + 1)}</span>
									{item}
								</li>
							))
						}
					</ol>
				</div>

				<div class="ew__note">
					<p class="ew__note-title">{noteTitle}</p>
					<p class="ew__note-body">{noteBody}</p>
					<a class="ew__note-cta" href={ctaLink} data-cta hidden>
						{ctaLabel}
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
					</a>
				</div>
			</aside>
		</div>
	</div>
</section>

<script>
	import { estimate, targetsFor, formatCost, STEPS } from '../data/estimator-model.mjs';

	const root = document.querySelector<HTMLElement>('.ew');
	const form = root?.querySelector<HTMLFormElement>('[data-estimator]');
	if (root && form) {
		const side = root.querySelector<HTMLElement>('[data-side]')!;
		const panels = new Map(
			STEPS.map((s) => [s.key, form.querySelector<HTMLElement>(`[data-panel="${s.key}"]`)!])
		);
		const rails = new Map(
			STEPS.map((s) => [s.key, root.querySelector<HTMLElement>(`[data-rail="${s.key}"]`)!])
		);
		const backBtn = form.querySelector<HTMLButtonElement>('[data-back]')!;
		const nextBtn = form.querySelector<HTMLButtonElement>('[data-next]')!;
		const nextLabel = form.querySelector<HTMLElement>('[data-next-label]')!;
		const restartBtn = form.querySelector<HTMLButtonElement>('[data-restart]')!;
		const targetNote = form.querySelector<HTMLElement>('[data-target-note]')!;
		const emptyEl = side.querySelector<HTMLElement>('[data-empty]')!;
		const resultEl = side.querySelector<HTMLElement>('[data-result]')!;
		const includesEl = side.querySelector<HTMLElement>('[data-includes]')!;
		const costEl = side.querySelector<HTMLElement>('[data-cost]')!;
		const hoursEl = side.querySelector<HTMLElement>('[data-hours]')!;
		const weeksEl = side.querySelector<HTMLElement>('[data-weeks]')!;
		const breakdownEl = side.querySelector<HTMLElement>('[data-breakdown]')!;
		const ctaEl = side.querySelector<HTMLAnchorElement>('[data-cta]')!;

		let index = 0;
		const answers: Record<string, string | string[]> = {};

		const stepAt = (i: number) => STEPS[i];
		/** Add-ons are optional — every other step needs an answer to continue. */
		const answered = (key: string) =>
			key === 'addons' ? true : typeof answers[key] === 'string' && answers[key] !== '';

		function readAnswers() {
			for (const step of STEPS) {
				if (step.type === 'multi') {
					answers[step.key] = Array.from(
						form.querySelectorAll<HTMLInputElement>(`input[name="${step.key}"]:checked`)
					).map((el) => el.value);
				} else {
					const checked = form.querySelector<HTMLInputElement>(`input[name="${step.key}"]:checked`);
					answers[step.key] = checked ? checked.value : '';
				}
			}
		}

		/** Target versions below the chosen current version can't be upgraded to. */
		function syncTargets() {
			const allowed = new Set(targetsFor(answers.current as string).map((t) => t.key));
			let clearedSelection = false;
			form.querySelectorAll<HTMLInputElement>('input[name="target"]').forEach((input) => {
				const ok = allowed.has(input.value);
				const item = input.closest('li');
				if (item) item.hidden = !ok;
				if (!ok && input.checked) {
					input.checked = false;
					clearedSelection = true;
				}
			});
			targetNote.hidden = allowed.size === STEPS.length;
			if (clearedSelection) readAnswers();
		}

		function renderEstimate() {
			const result = estimate(answers);
			const complete = index >= STEPS.length - 1 && result !== null;

			if (!result) {
				emptyEl.hidden = false;
				resultEl.hidden = true;
				includesEl.hidden = false;
				ctaEl.hidden = true;
				return;
			}

			emptyEl.hidden = true;
			resultEl.hidden = false;
			// Once the range is on screen the placeholder list is just noise.
			includesEl.hidden = true;
			ctaEl.hidden = !complete;

			costEl.textContent = `${formatCost(result.costLow)} – ${formatCost(result.costHigh)}`;
			hoursEl.textContent = `${result.lowHours} – ${result.highHours} hrs`;
			weeksEl.textContent = `${result.weeksLow} – ${result.weeksHigh} weeks`;

			const lines: { label: string; value: string }[] = [
				{ label: `Upgrade path (${answers.current}.x → ${answers.target}.x)`, value: `${result.coreHours} hrs` },
			];
			if (result.phpBumpNeeded) {
				lines.push({ label: `PHP upgrade to ${result.minPhp}`, value: `${result.phpBumpHours} hrs` });
			}
			for (const addon of result.addonLines) {
				lines.push({ label: addon.label, value: `${addon.hours} hrs` });
			}
			breakdownEl.innerHTML = '';
			for (const line of lines) {
				const li = document.createElement('li');
				const label = document.createElement('span');
				label.textContent = line.label;
				const value = document.createElement('span');
				value.className = 'ew__breakdown-value';
				value.textContent = line.value;
				li.append(label, value);
				breakdownEl.append(li);
			}
		}

		function show(i: number) {
			index = Math.max(0, Math.min(STEPS.length - 1, i));
			STEPS.forEach((step, n) => {
				panels.get(step.key)!.hidden = n !== index;
				rails.get(step.key)!.classList.toggle('is-active', n === index);
				rails.get(step.key)!.classList.toggle('is-done', n < index);
			});
			backBtn.hidden = index === 0;
			const last = index === STEPS.length - 1;
			restartBtn.hidden = !last;
			nextBtn.hidden = last;
			nextLabel.textContent = last ? 'See your estimate' : 'Next';
			nextBtn.disabled = !answered(stepAt(index).key);
			if (stepAt(index).key === 'target') syncTargets();
			renderEstimate();
		}

		form.addEventListener('change', (event) => {
			const input = (event.target as HTMLElement).closest<HTMLInputElement>('.ew__input');
			if (!input) return;
			readAnswers();
			if (input.name === 'current') syncTargets();
			nextBtn.disabled = !answered(stepAt(index).key);
			renderEstimate();
			// A single-choice answer is unambiguous, so move on without a second click.
			if (input.type === 'radio' && index < STEPS.length - 1) {
				window.setTimeout(() => show(index + 1), 180);
			}
		});

		nextBtn.addEventListener('click', () => show(index + 1));
		backBtn.addEventListener('click', () => show(index - 1));
		restartBtn.addEventListener('click', () => {
			form.reset();
			readAnswers();
			show(0);
		});

		/**
		 * Carry the estimate into the enquiry: the visitor has just answered seven
		 * questions, so asking them to retype it would be rude. Only fills a
		 * message box they haven't written in themselves.
		 */
		ctaEl.addEventListener('click', () => {
			const result = estimate(answers);
			if (!result) return;
			const target = document.querySelector<HTMLTextAreaElement>('#contact textarea, #contact [name="message"]');
			if (target && !target.value.trim()) {
				const addons = result.addonLines.map((a) => a.label).join(', ');
				target.value = [
					`Laravel ${answers.current}.x → ${answers.target}.x upgrade.`,
					`Estimator says ${result.lowHours}–${result.highHours} hrs (${formatCost(result.costLow)}–${formatCost(result.costHigh)}), ${result.weeksLow}–${result.weeksHigh} weeks.`,
					addons ? `Also relevant: ${addons}.` : '',
					"I'd like a technical audit to firm this up.",
				]
					.filter(Boolean)
					.join('\n');
			}
			window.dataLayer = window.dataLayer || [];
			window.dataLayer.push({
				event: 'estimator_complete',
				estimator_hours_low: result.lowHours,
				estimator_hours_high: result.highHours,
				estimator_cost_low: result.costLow,
				estimator_cost_high: result.costHigh,
			});
		});

		readAnswers();
		show(0);
	}
</script>

<style>
	/* --- Intro band --- */
	.ew__intro {
		background: var(--surface-muted);
		padding-block: clamp(2.5rem, 5vw, 4rem);
	}
	.ew__intro-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: center;
	}
	.ew__eyebrow {
		color: var(--color-primary-blue);
		margin-bottom: 0.85rem;
	}
	.ew__heading {
		font-size: var(--fs-h2-fluid);
		font-weight: var(--fw-semibold);
		line-height: var(--lh-tight);
		letter-spacing: var(--ls-h2);
		color: var(--color-headings-dark);
	}
	.ew__body {
		margin-top: 1rem;
		max-width: 56ch;
		font-size: var(--fs-small);
		line-height: var(--lh-body);
		color: var(--color-paragraph);
		border-left: 3px solid var(--color-lavender);
		padding-left: 1.25rem;
	}
	.ew__stats {
		display: flex;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		margin: 0;
		padding: 0;
	}
	.ew__stat {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-left: 1.25rem;
		border-left: 1px solid var(--color-light-lavender);
	}
	.ew__stat-value {
		font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
		line-height: 1;
		color: var(--color-fuchsia);
	}
	.ew__stat-value.is-blue {
		color: var(--color-primary-blue);
	}
	.ew__stat-label {
		font-size: var(--fs-category);
		color: var(--color-paragraph);
	}

	/* --- Progress rail --- */
	.ew__main {
		padding-block: clamp(2.5rem, 5vw, 4rem);
	}
	.ew__rail {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 0.75rem;
		margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
		padding: 0;
	}
	.ew__rail-step {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.ew__rail-label {
		font-size: var(--fs-category);
		font-weight: var(--fw-semibold);
		letter-spacing: var(--ls-category);
		text-transform: uppercase;
		color: var(--color-light-lavender);
		white-space: nowrap;
	}
	.ew__rail-num {
		color: var(--color-light-lavender);
	}
	.ew__rail-step.is-active .ew__rail-label,
	.ew__rail-step.is-done .ew__rail-label {
		color: var(--color-headings-dark);
	}
	.ew__rail-step.is-active .ew__rail-num {
		color: var(--color-primary-blue);
	}
	.ew__rail-bar {
		height: 3px;
		background: var(--surface-lavender-tint);
		transition: background 0.2s ease;
	}
	.ew__rail-step.is-active .ew__rail-bar,
	.ew__rail-step.is-done .ew__rail-bar {
		background: var(--color-primary-blue);
	}
	.ew__rail-dot {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		border: 1.5px solid var(--color-light-lavender);
		background: var(--color-white);
	}
	.ew__rail-step.is-active .ew__rail-dot {
		border-color: var(--color-primary-blue);
		box-shadow: inset 0 0 0 2px var(--color-light-yellow);
	}
	.ew__rail-step.is-done .ew__rail-dot {
		border-color: var(--color-primary-blue);
		background: var(--color-primary-blue);
	}

	/* --- Card + sidebar --- */
	.ew__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
		gap: clamp(1rem, 2vw, 1.5rem);
		align-items: start;
	}
	.ew__card {
		position: relative;
		background: var(--surface-card);
		border: 1px solid var(--surface-lavender-tint);
		border-top: 4px solid var(--color-primary-blue);
		padding: clamp(1.5rem, 3vw, 2.5rem);
	}
	.ew__panel {
		border: 0;
		margin: 0;
		padding: 0;
		min-width: 0;
	}
	.ew__step-count {
		color: var(--color-primary-blue);
		margin-bottom: 0.85rem;
	}
	.ew__question {
		display: block;
		padding: 0;
		font-size: var(--fs-h5-fluid);
		font-weight: var(--fw-semibold);
		line-height: var(--lh-h5);
		letter-spacing: var(--ls-h5);
		color: var(--color-headings-dark);
		max-width: 22ch;
	}
	.ew__hint {
		margin-top: 0.75rem;
		font-size: var(--fs-small);
		color: var(--color-paragraph);
	}
	.ew__hint--inline {
		margin-top: 1rem;
	}

	.ew__options {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin: 1.75rem 0 0;
		padding: 0;
	}
	.ew__option {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		height: 100%;
		padding: 1rem 1.15rem;
		background: var(--surface-lavender-tint);
		border: 1px solid transparent;
		cursor: pointer;
		transition:
			background 0.15s ease,
			border-color 0.15s ease;
	}
	.ew__option:hover {
		border-color: var(--color-lavender);
	}
	.ew__input {
		position: absolute;
		opacity: 0;
		width: 0;
		height: 0;
	}
	.ew__marker {
		flex: none;
		width: 20px;
		height: 20px;
		margin-top: 0.1rem;
		border: 1.5px solid var(--color-primary-blue);
		border-radius: 50%;
		background: var(--color-white);
		transition: box-shadow 0.15s ease;
	}
	/* Multi-select reads as a checkbox, single-select as a radio. */
	.ew__input[type='checkbox'] + .ew__marker {
		border-radius: 3px;
	}
	.ew__input:checked + .ew__marker {
		box-shadow: inset 0 0 0 4px var(--color-primary-blue);
	}
	.ew__input:focus-visible + .ew__marker {
		outline: 2px solid var(--color-primary-blue);
		outline-offset: 2px;
	}
	.ew__option:has(.ew__input:checked) {
		background: var(--color-white);
		border-color: var(--color-primary-blue);
	}
	.ew__option-text {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}
	.ew__option-label {
		font-size: var(--fs-small);
		font-weight: var(--fw-semibold);
		color: var(--color-headings-dark);
	}
	.ew__option-desc {
		font-size: var(--fs-category);
		line-height: var(--lh-body);
		color: var(--color-paragraph);
	}

	.ew__update {
		margin-top: 1.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--surface-lavender-tint);
		font-size: var(--fs-category);
		color: var(--color-paragraph);
	}

---
import { storyblokEditable } from '@storyblok/astro';
import Button from '../components/Button.astro';
import { splitHighlight } from '../lib/text';

const { blok } = Astro.props;

interface Phone {
	number: string;
	label: string;
}

const eyebrow: string = blok?.eyebrow || 'Get started';
const heading: string =
	blok?.heading || 'Your site deserves better than hoping for the best';
const accent: string = blok?.heading_accent || 'hoping for the best';
const body: string =
	blok?.body ||
	"Get a free, no-obligation review of your site's security, performance, and maintenance risks. We'll tell you exactly what we'd do and what it costs.";
const phones: Phone[] = blok?.phones?.length
	? blok.phones
	: [
			{ number: '0207 993 5485', label: 'Call us: Watford & London' },
			{ number: '01908 110 420', label: 'Call us: Milton Keynes' },
		];
const formCtaLabel: string = blok?.form_cta_label || 'Get My Free Review';

// Presentation options other pages set (the Laravel page reuses this section).
// Every default preserves the original home-page look.
const tone: 'fuchsia' | 'blue' = blok?.tone === 'blue' ? 'blue' : 'fuchsia';
const formTitle: string = blok?.form_title || '';
const bodyStrong: string = blok?.body_strong || '';
const showMessage = Boolean(blok?.show_message);
const labelsFirst = Boolean(blok?.labels_first);
const formSource: string = blok?.form_source || 'cta';
/** Reassurance line under the submit button (Laravel page). */
const formNote: string = blok?.form_note || '';

const h = splitHighlight(heading, accent);
---

<section class:list={['cta', `tone-${tone}`]} id="contact" {...storyblokEditable(blok)}>
	<div class="cta__inner container">
		<div class="cta__content">
			<p class="cta__eyebrow category">{eyebrow}</p>
			<h2 class="cta__heading">{h.pre}<span class="cta__hl">{h.mid}</span>{h.post}</h2>
			<p class="cta__body">{body}</p>
			{bodyStrong && <p class="cta__body cta__body--strong">{bodyStrong}</p>}

			<ul class="cta__phones" role="list">
				{
					phones.map((p) => (
						<li class="cta__phone">
							{labelsFirst && <span class="cta__phone-label">{p.label}</span>}
							<a class="cta__phone-number" href={`tel:${p.number.replace(/[^\d+]/g, '')}`}>{p.number}</a>
							{!labelsFirst && <span class="cta__phone-label">{p.label}</span>}
						</li>
					))
				}
			</ul>
		</div>

		<form class="cta__form" action="/api/lead" method="post" data-lead novalidate>
			{formTitle && <h3 class="cta__form-title">{formTitle}</h3>}
			<input type="hidden" name="source" value={formSource} />
			<input type="hidden" name="page" value="" />
			<input class="lead-hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
			<div class="cta__fields" data-lead-fields>
				<label class="visually-hidden" for="contact-name">Name</label>
				<input class="cta__input" id="contact-name" name="name" type="text" placeholder="Name" autocomplete="name" />
				<label class="visually-hidden" for="contact-email">Email</label>
				<input class="cta__input" id="contact-email" name="email" type="email" placeholder="Email" autocomplete="email" required />
				{
					showMessage ? (
						<>
							<label class="visually-hidden" for="contact-message">What are you building?</label>
							<textarea class="cta__input cta__textarea" id="contact-message" name="message" placeholder="What are you building?" rows="3" />
						</>
					) : (
						<>
							<label class="visually-hidden" for="contact-phone">Phone</label>
							<input class="cta__input" id="contact-phone" name="phone" type="tel" placeholder="Phone" autocomplete="tel" />
						</>
					)
				}
				<Button label={formCtaLabel} variant={tone === 'blue' ? 'primary' : 'deep'} icon="arrow-right" type="submit" />
				{formNote && <p class="cta__note">{formNote}</p>}
			</div>
			<p class="cta__status" data-lead-status aria-live="polite"></p>
		</form>
	</div>
</section>

<style>
	.cta {
		position: relative;
		color: var(--color-white);
		/* Figma: #cf1993 base with the five diagonal "Subtract" shapes layered
		   over it (composited exactly in /public/cta-bg.svg). */
		background: var(--color-fuchsia) url('/cta-bg.svg') center / cover no-repeat;
		overflow: hidden;
	}
	.cta__inner {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: clamp(2rem, 4vw, 4rem);
		align-items: center;
		padding-block: clamp(3rem, 6vw, 5.5rem);
	}

	.cta__eyebrow {
		color: var(--text-on-dark);
		margin-bottom: 1rem;
	}
	.cta__heading {
		color: var(--color-white);
		font-size: var(--fs-h2-fluid);
		font-weight: var(--fw-semibold);
		line-height: var(--lh-tight);
		letter-spacing: var(--ls-h2);
		max-width: 22ch;
	}
	.cta__hl {
		color: var(--color-dark-blue); /* Figma: "hoping for the best" is Dark Blue */
	}
	.cta__body {
		max-width: 46ch;
		margin-top: 1.25rem;
		font-size: var(--fs-small);
		line-height: var(--lh-body);
		color: var(--text-on-dark);
	}
	.cta__phones {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem 3rem;
		margin: 2rem 0 0;
		padding: 2rem 0 0;
		/* Divider above the phone numbers (per feedback). */
		border-top: 1px solid rgba(255, 255, 255, 0.3);
	}
	.cta__phone-number {
		display: block;
		font-size: var(--fs-h5);
		font-weight: var(--fw-semibold);
		letter-spacing: var(--ls-h5);
		color: var(--color-white);
	}
	.cta__phone-label {
		font-size: var(--fs-small);
		color: var(--text-on-dark-muted);
	}

	.cta__form {
		padding: clamp(1.5rem, 2.5vw, 2.25rem);
		background: rgba(22, 16, 38, 0.28);
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: var(--radius-card);
	}
	.cta__fields {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.cta__status {
		margin-top: 1rem;
		font-size: var(--fs-small);
		color: var(--text-on-dark);
	}
	.cta__status:empty {
		display: none;
	}
	.cta__status[data-state='ok'] {
		color: var(--color-light-green);
	}
	.cta__status[data-state='error'] {
		color: var(--color-light-pink);
	}
	/* Figma node 364:707: dark fill, bottom border only, 21px text. */
	.cta__input {
		height: 54px;
		padding: 8px 8px;
		border: 0;
		border-bottom: 1px solid var(--color-white-80);
		border-radius: 0;
		background: rgba(22, 16, 38, 0.4);
		color: var(--color-white);
		font-size: var(--fs-paragraph);
	}
	.cta__input::placeholder {
		color: rgba(255, 255, 255, 0.5);
	}
	.cta__input:focus-visible {
		outline: 2px solid var(--color-cyan);
		outline-offset: 1px;
	}
	.cta__form :global(.btn) {
		align-self: flex-start;
		height: 46px;
		padding-inline: 28px 22px;
		font-size: var(--fs-small);
		gap: 16px;
		margin-top: 0.25rem;
	}

	/* --- Laravel page options --- */
	.cta__body--strong {
		font-weight: var(--fw-semibold);
		color: var(--color-white);
	}
	.cta__form-title {
		margin-bottom: 1.25rem;
		font-size: var(--fs-h5-fluid);
		font-weight: var(--fw-semibold);
		line-height: var(--lh-h5);
		letter-spacing: var(--ls-h5);
		color: var(--color-light-yellow);
	}
	.cta__textarea {
		height: auto;
		min-height: 104px;
		padding-block: 0.75rem;
		resize: vertical;
		font-family: inherit;
	}
	/* Solid Primary Blue band with a dark form card (no diagonal shapes). */
	.cta.tone-blue {
		background: var(--color-primary-blue);
	}
	/* Design: the card is a darker wash over the section, the fields are solid
	   dark blue with only a lavender bottom rule (same underline style as the
	   fuchsia form). */
	.cta.tone-blue .cta__form {
		background: rgba(42, 12, 103, 0.55);
		border-color: rgba(202, 187, 231, 0.55);
	}
	.cta.tone-blue .cta__input {
		background: var(--color-dark-blue);
		border-bottom-color: rgba(170, 140, 231, 0.7);
	}
	.cta.tone-blue .cta__input::placeholder {
		color: var(--color-light-lavender);
	}
	.cta.tone-blue .cta__eyebrow {
		color: var(--color-lavender);
	}
	.cta.tone-blue .cta__phone-label {
		color: var(--text-on-dark);
	}
	.cta.tone-blue .cta__phones {
		gap: 1.5rem 2.5rem;
	}
	/* Design: full-width submit with the reassurance line centred beneath. */
	.cta.tone-blue .cta__fields :global(.btn) {
		align-self: stretch;
		width: 100%;
	}
	.cta__note {
		margin-top: 0.25rem;
		text-align: center;
		font-size: var(--fs-category);
		color: var(--text-on-dark-muted);
	}

	@media (max-width: 880px) {
		.cta__inner {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import '../scripts/lead-form';
</script>

---
import { storyblokEditable } from '@storyblok/astro';
import { splitHighlight } from '../lib/text';

const { blok } = Astro.props;

interface Stat {
	value: string;
	description: string;
}

const eyebrow: string = blok?.eyebrow || 'The risk of doing nothing';
const heading: string = blok?.heading || 'The threats are real – is your site ready?';
const accent: string = blok?.heading_accent || 'real';
const stats: Stat[] = blok?.stats?.length
	? blok.stats
	: [
			{ value: '7.78m', description: 'Cyber attacks recorded in the UK last year alone – up 77% year on year' },
			{ value: '84%', description: 'of UK businesses reported a phishing attack – the most common entry point' },
			{ value: '94%', description: 'of organisations experienced an email-borne security incident in the last year' },
			{ value: '£17.5m', description: 'Maximum GDPR fine for a data breach – or 4% of global annual turnover' },
		];
const footnote: string = blok?.footnote || "Don't leave your site unprotected.";
const ctaLabel: string = blok?.cta_label || 'Get a free security review';
const ctaLink: string = blok?.cta_link || '#contact';

const h = splitHighlight(heading, accent);
---

<section class="risk" {...storyblokEditable(blok)}>
	<div class="risk__inner container">
		<p class="risk__eyebrow category">{eyebrow}</p>
		<h2 class="risk__heading section-heading">{h.pre}<span class="risk__hl">{h.mid}</span>{h.post}</h2>

		<ul class="risk__grid" role="list">
			{
				stats.map((s) => (
					<li class="risk__stat">
						<span class="risk__value">{s.value}</span>
						<p class="risk__desc">{s.description}</p>
					</li>
				))
			}
		</ul>

		<p class="risk__foot">
			{footnote} <a class="risk__link" href={ctaLink}>{ctaLabel} →</a>
		</p>
	</div>
</section>

<style>
	.risk {
		background: var(--surface-muted); /* Figma: Light BG 2 #f8f7fa */
		padding-block: var(--section-py);
	}
	.risk__eyebrow {
		color: var(--color-primary-blue);
		margin-bottom: 1rem;
	}
	.risk__heading {
		color: var(--color-dark-blue);
		max-width: 22ch;
		margin-bottom: clamp(2rem, 4vw, 3.5rem);
	}
	.risk__hl {
		color: var(--color-fuchsia);
	}
	.risk__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: clamp(1.5rem, 3vw, 2.5rem);
		margin: 0;
		padding: 0;
	}
	.risk__stat {
		padding-left: 1.5rem;
		border-left: 2px solid var(--color-light-lavender);
	}
	.risk__value {
		display: block;
		/* Figma: Inter Regular 72px, line-height 1.25, tracking -5% */
		font-size: clamp(2.25rem, 1.3rem + 3vw, 4.5rem);
		font-weight: var(--fw-regular);
		line-height: var(--lh-tight);
		letter-spacing: -0.05em;
		color: var(--color-fuchsia);
		margin-bottom: 1rem;
	}
	.risk__desc {
		font-size: var(--fs-paragraph-fluid); /* Figma: Paragraph 21px */
		line-height: var(--lh-body);
		color: var(--color-paragraph);
	}
	.risk__foot {
		margin-top: clamp(2rem, 4vw, 3rem);
		font-size: var(--fs-small);
		color: var(--color-paragraph);
	}
	.risk__link {
		font-weight: var(--fw-semibold);
		color: var(--color-primary-blue);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.risk__link:hover {
		color: var(--color-fuchsia);
	}

	@media (max-width: 860px) {
		.risk__grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 460px) {
		.risk__grid {
			grid-template-columns: 1fr;
		}
	}
</style>

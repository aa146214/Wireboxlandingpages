---
import { storyblokEditable } from '@storyblok/astro';
import Icon from '../components/Icon.astro';

const { blok } = Astro.props;

interface CaseStudy {
	title: string;
	description: string;
	tags: string[] | string;
	image?: { filename?: string } | string;
	link?: { cached_url?: string; url?: string } | string;
}

const heading: string = blok?.heading || 'Case studies_';
const items: CaseStudy[] = blok?.items ?? [];
const img = (i: CaseStudy['image']) => (typeof i === 'string' ? i : i?.filename);
const toTags = (t: CaseStudy['tags']): string[] =>
	Array.isArray(t)
		? t
		: typeof t === 'string'
			? t.split(/\r?\n|,/).map((s) => s.trim()).filter(Boolean)
			: [];
const resolveLink = (l: CaseStudy['link']) =>
	!l ? '#' : typeof l === 'string' ? l : l.cached_url || l.url || '#';
---

<section class="case-studies" {...storyblokEditable(blok)}>
	<div class="case-studies__inner container">
		<div class="case-studies__head">
			<h2 class="case-studies__heading section-heading">{heading}</h2>
			<div class="case-studies__nav">
				<button type="button" class="case-studies__arrow" data-dir="-1" aria-label="Previous case studies">
					<Icon name="arrow-right" size={22} class="flip" />
				</button>
				<button type="button" class="case-studies__arrow" data-dir="1" aria-label="Next case studies">
					<Icon name="arrow-right" size={22} />
				</button>
			</div>
		</div>
	</div>

	<div class="case-studies__viewport" data-cs-viewport>
		<ul class="case-studies__track" role="list">
			{
				items.map((cs) => (
					<li class="cs-card">
						<a class="cs-card__link" href={resolveLink(cs.link)}>
							<div class="cs-card__media">
								<img src={img(cs.image)} alt={`${cs.title} case study`} width="437" height="437" loading="lazy" />
							</div>
							<ul class="cs-card__tags" role="list">
								{toTags(cs.tags).map((t) => <li>{t}</li>)}
							</ul>
							<h3 class="cs-card__title">{cs.title}</h3>
							<p class="cs-card__desc">{cs.description}</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.case-studies {
		background: var(--surface-page);
		padding-block: var(--section-py-sm);
	}
	.case-studies__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}
	.case-studies__heading {
		color: var(--color-dark-blue);
	}
	.case-studies__nav {
		display: flex;
		gap: 0.75rem;
	}
	.case-studies__arrow {
		width: 48px;
		height: 48px;
		display: grid;
		place-items: center;
		border-radius: var(--radius-sm);
		background: var(--surface-subtle);
		color: var(--color-primary-blue);
		transition:
			background var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}
	.case-studies__arrow:hover {
		background: var(--color-primary-blue);
		color: var(--color-white);
	}
	.case-studies__arrow :global(.flip) {
		transform: scaleX(-1);
	}

	.case-studies__viewport {
		overflow-x: auto;
		scrollbar-width: none;
	}
	.case-studies__viewport::-webkit-scrollbar {
		display: none;
	}
	.case-studies__track {
		display: flex;
		gap: clamp(1.5rem, 3vw, 64px);
		margin: 0;
		padding: 1rem var(--container-pad);
		width: max-content;
	}
	.cs-card {
		flex: 0 0 437px;
		max-width: 85vw;
	}
	.cs-card__link {
		display: block;
	}
	.cs-card__media {
		border-radius: var(--radius-md);
		overflow: hidden;
		margin-bottom: 1.25rem;
		aspect-ratio: 1;
	}
	.cs-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-base) var(--ease-out);
	}
	.cs-card__link:hover .cs-card__media img {
		transform: scale(1.04);
	}
	.cs-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.85rem;
		margin: 0 0 0.85rem;
		padding: 0;
	}
	.cs-card__tags li {
		font-size: var(--fs-category);
		font-weight: var(--fw-semibold);
		letter-spacing: var(--ls-category);
		text-transform: uppercase;
		color: var(--color-primary-blue);
	}
	.cs-card__title {
		font-size: var(--fs-h5);
		font-weight: var(--fw-semibold);
		line-height: var(--lh-h5);
		letter-spacing: var(--ls-h5);
		color: var(--color-headings-dark);
		margin-bottom: 0.5rem;
	}
	.cs-card__desc {
		font-size: var(--fs-small);
		line-height: var(--lh-body);
		color: var(--color-paragraph);
		max-width: 38ch;
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-cs-viewport]').forEach((vp) => {
		const card = vp.querySelector<HTMLElement>('.cs-card');
		const nav = vp.previousElementSibling;
		const step = card ? card.offsetWidth + 64 : 480;
		nav?.querySelectorAll<HTMLButtonElement>('.case-studies__arrow').forEach((btn) => {
			btn.addEventListener('click', () => {
				vp.scrollBy({ left: step * Number(btn.dataset.dir ?? 1), behavior: 'smooth' });
			});
		});
	});
</script>

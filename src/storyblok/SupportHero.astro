---
import { storyblokEditable } from '@storyblok/astro';
import Button from '../components/Button.astro';
import { splitHighlight } from '../lib/text';
import type { ButtonVariant } from '../lib/ui';
import type { IconName } from '../lib/icons';

const { blok } = Astro.props;

interface CtaBlok {
	label: string;
	link?: { url?: string; cached_url?: string } | string;
	variant?: ButtonVariant;
	icon?: IconName | null;
}
interface Stat {
	value: string;
	label: string;
	tone?: 'pink' | 'green';
}

const eyebrow: string = blok?.eyebrow || '245 sites protected & monitored';
const heading: string =
	blok?.heading || 'Never lose a sale to a\nbroken website again';
const accent: string = blok?.heading_accent || 'broken website';
const body: string =
	blok?.body ||
	'Wirebox is your dedicated website support partner – monitoring, protecting, and improving your site 24/7 so you can focus on running your business.';

const ctas: CtaBlok[] = blok?.ctas?.length
	? blok.ctas
	: [
			{ label: 'get a free site review', link: '#contact', variant: 'primary', icon: 'arrow-right' },
			{ label: 'see plans & pricing', link: '#pricing', variant: 'outline', icon: 'arrow-right' },
		];

const cardTitle: string = blok?.card_title || 'Our response commitments';
const stats: Stat[] = blok?.stats?.length
	? blok.stats
	: [
			{ value: '1hr', label: 'critical issue response', tone: 'pink' },
			{ value: '4hrs', label: 'standard issue response', tone: 'green' },
			{ value: '24/7', label: 'uptime monitoring', tone: 'pink' },
			{ value: '99.9%', label: 'target uptime', tone: 'green' },
		];
const formTitle: string = blok?.form_title || 'Get your free site review';
const formNote: string =
	blok?.form_note || "No obligation · We'll respond within 1 business day";
const formCtaLabel: string = blok?.form_cta_label || 'review my site';

const h = splitHighlight(heading, accent);
---

<section class="s-hero" {...storyblokEditable(blok)}>
	<div class="s-hero__inner container">
		<div class="s-hero__content">
			<p class="s-hero__eyebrow category">{eyebrow}</p>
			<h1 class="s-hero__heading">{h.pre}<span class="s-hero__hl">{h.mid}</span>{h.post}</h1>
			<p class="s-hero__body">{body}</p>
			<div class="s-hero__actions">
				{
					ctas.map((cta) => (
						<Button
							label={cta.label}
							link={cta.link}
							variant={cta.variant ?? 'primary'}
							icon={cta.icon ?? null}
						/>
					))
				}
			</div>
		</div>

		<aside class="s-hero__card">
			<p class="s-hero__card-title">{cardTitle}</p>
			<ul class="s-hero__stats" role="list">
				{
					stats.map((s) => (
						<li class:list={['s-hero__stat', `is-${s.tone ?? 'pink'}`]}>
							<span class="s-hero__stat-value">{s.value}</span>
							<span class="s-hero__stat-label">{s.label}</span>
						</li>
					))
				}
			</ul>

			<form class="s-hero__form" id="hero-review" novalidate>
				<p class="s-hero__form-title category">{formTitle}</p>
				<div class="s-hero__form-row">
					<label class="visually-hidden" for="hero-email">Your email address</label>
					<input
						class="s-hero__input"
						id="hero-email"
						type="email"
						name="email"
						placeholder="your@email.com"
						autocomplete="email"
					/>
					<Button label={formCtaLabel} variant="fuchsia" icon="arrow-right" type="submit" />
				</div>
				<p class="s-hero__form-note">
					<span aria-hidden="true">🔒</span> {formNote}
				</p>
			</form>
		</aside>
	</div>
</section>

<style>
	.s-hero {
		position: relative;
		color: var(--color-white);
		background:
			radial-gradient(120% 90% at 85% 10%, rgba(64, 224, 240, 0.12), transparent 55%),
			linear-gradient(115deg, #4a14bb 0%, var(--color-primary-blue) 45%, #45129f 100%);
		overflow: hidden;
	}

	.s-hero__inner {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		align-items: center;
		gap: clamp(2rem, 4vw, 4.5rem);
		padding-block: clamp(3rem, 6vw, 6rem);
	}

	.s-hero__eyebrow {
		color: var(--color-light-yellow);
		margin-bottom: 1.25rem;
	}
	.s-hero__heading {
		color: var(--color-white);
		font-size: var(--fs-h1-fluid);
		font-weight: var(--fw-semibold);
		line-height: var(--lh-tight);
		letter-spacing: var(--ls-h1);
		white-space: pre-line;
		text-wrap: balance;
	}
	.s-hero__hl {
		color: var(--color-light-yellow);
	}
	@media (max-width: 560px) {
		.s-hero__heading {
			white-space: normal;
		}
	}
	.s-hero__body {
		max-width: 46ch;
		margin-top: 1.5rem;
		font-size: var(--fs-paragraph-fluid);
		line-height: var(--lh-body);
		color: var(--text-on-dark);
	}
	.s-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-top: 2.25rem;
	}

	/* --- Response-commitments card --- */
	.s-hero__card {
		padding: clamp(1.5rem, 2vw, 2rem);
		background: rgba(42, 12, 103, 0.2);
		border: 1px solid rgba(248, 247, 250, 0.6);
		border-radius: var(--radius-card);
		backdrop-filter: blur(2px);
	}
	.s-hero__card-title {
		font-size: var(--fs-category);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-light-lavender);
		margin-bottom: 1rem;
	}
	.s-hero__stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin: 0 0 1.5rem;
		padding: 0;
	}
	.s-hero__stat {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.1rem 1.25rem;
		background: rgba(42, 12, 103, 0.45);
		border-radius: var(--radius-card);
	}
	.s-hero__stat-value {
		font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.7rem);
		font-weight: var(--fw-semibold);
		line-height: 1.05;
		letter-spacing: var(--ls-h3);
	}
	.s-hero__stat-label {
		font-size: var(--fs-small);
		line-height: 1.3;
	}
	.s-hero__stat.is-pink .s-hero__stat-value,
	.s-hero__stat.is-pink .s-hero__stat-label {
		color: var(--color-light-pink);
	}
	.s-hero__stat.is-green .s-hero__stat-value,
	.s-hero__stat.is-green .s-hero__stat-label {
		color: var(--color-light-green);
	}

	.s-hero__form-title {
		color: var(--text-on-dark);
		margin-bottom: 0.75rem;
	}
	.s-hero__form-row {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.s-hero__input {
		flex: 1 1 12rem;
		min-width: 0;
		height: 54px;
		padding-inline: 1.25rem;
		border: 1px solid transparent;
		border-radius: var(--radius-card);
		background: var(--color-white-80);
		color: var(--color-headings-dark);
		font-size: var(--fs-small);
	}
	.s-hero__input::placeholder {
		color: #8a85a0;
	}
	.s-hero__input:focus-visible {
		outline: 2px solid var(--color-light-yellow);
		outline-offset: 2px;
	}
	.s-hero__form-row :global(.btn) {
		flex: 0 0 auto;
		padding-inline: 28px 22px;
	}
	.s-hero__form-note {
		margin-top: 1rem;
		font-size: var(--fs-small);
		color: var(--text-on-dark-muted);
	}

	@media (max-width: 960px) {
		.s-hero__inner {
			grid-template-columns: 1fr;
		}
	}
</style>

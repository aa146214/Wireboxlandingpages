---
import { storyblokEditable } from '@storyblok/astro';
import Button from '../components/Button.astro';
import { splitHighlight } from '../lib/text';
import type { ButtonVariant } from '../lib/ui';
import type { IconName } from '../lib/icons';

const { blok } = Astro.props;

interface CtaBlok {
	label: string;
	link?: { url?: string; cached_url?: string } | string;
	variant?: ButtonVariant;
	icon?: IconName | null;
}
interface Stat {
	value: string;
	label: string;
	tone?: 'pink' | 'green';
}

const eyebrow: string = blok?.eyebrow || '245 sites protected & monitored';
const heading: string =
	blok?.heading || 'Never lose a sale to a\nbroken website again';
const accent: string = blok?.heading_accent || 'broken website';
const body: string =
	blok?.body ||
	'Wirebox is your dedicated website support partner – monitoring, protecting, and improving your site 24/7 so you can focus on running your business.';

const ctas: CtaBlok[] = blok?.ctas?.length
	? blok.ctas
	: [
			{ label: 'get a free site review', link: '#contact', variant: 'primary', icon: 'arrow-right' },
			{ label: 'see plans & pricing', link: '#pricing', variant: 'outline', icon: 'arrow-right' },
		];

const cardTitle: string = blok?.card_title || 'Our response commitments';
// Figma order: critical → uptime → standard → target (pinks first, then greens).
const stats: Stat[] = blok?.stats?.length
	? blok.stats
	: [
			{ value: '1hr', label: 'critical issue response', tone: 'pink' },
			{ value: '24/7', label: 'uptime monitoring', tone: 'pink' },
			{ value: '4hrs', label: 'standard issue response', tone: 'green' },
			{ value: '99.9%', label: 'target uptime', tone: 'green' },
		];

/**
 * Hero video, all editable in Storyblok. A YouTube or Vimeo link wins if set;
 * otherwise a file uploaded to the asset library plays inline; otherwise the
 * poster image shows on its own.
 *
 * YouTube goes through youtube-nocookie.com so the embed doesn't set tracking
 * cookies before a visitor has actually played anything.
 */
function embedUrl(raw?: string): string {
	if (!raw) return '';
	const v = String(raw).trim();
	const yt = v.match(/(?:youtu\.be\/|[?&]v=|\/embed\/|\/shorts\/)([A-Za-z0-9_-]{11})/);
	if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`;
	// A bare 11-char id that isn't all digits is a YouTube id.
	if (/^[A-Za-z0-9_-]{11}$/.test(v) && !/^\d+$/.test(v)) {
		return `https://www.youtube-nocookie.com/embed/${v}`;
	}
	const vimeo = v.match(/\d{6,}/);
	return vimeo ? `https://player.vimeo.com/video/${vimeo[0]}` : '';
}

/**
 * Three above-the-fold treatments share this component:
 *   'card'  – commitments + form in a card on the right of the hero (original)
 *   'video' – video on the right, commitments + form in a band underneath
 *   'enquiry' - a four-field enquiry form in place of the commitments card
 * Defaults to 'card' so an unset value keeps the original layout.
 */
const layout: 'card' | 'video' | 'enquiry' =
	blok?.layout === 'video' ? 'video' : blok?.layout === 'enquiry' ? 'enquiry' : 'card';

const videoEmbed: string = embedUrl(blok?.video);
const videoFile: string = blok?.video_file?.filename || '';
const videoPoster: string = blok?.video_poster?.filename || '';
const videoTitle: string = blok?.video_title || 'Wirebox website support explained';
const formTitle: string = blok?.form_title || 'Get your free site review';
const formNote: string =
	blok?.form_note || "No obligation · We'll respond within 1 business day";
const formCtaLabel: string = blok?.form_cta_label || 'review my site';
const bgImage: string =
	blok?.bg_image?.filename || '/seed-assets/support/hero-building.png';

/**
 * Enquiry layout ('enquiry'). Storyblok-editable so a campaign page can be
 * reworded without a deploy.
 *
 * enquiry_action is deliberately empty by default. Until the client says where
 * these enquiries should go, the form renders but refuses to submit rather than
 * quietly POSTing to the page it sits on. Point it at /api/lead once that is
 * decided: that endpoint already emails a "Company:" line and uses hp_url as
 * its honeypot. Do NOT point it at /api/report, which treats a filled-in
 * company field as its own honeypot and would silently discard every enquiry.
 */
const enquiryTitle: string =
	blok?.enquiry_title ||
	'Find out a better, safer and cheaper way to maintain and support your website';
const enquiryCtaLabel: string = blok?.enquiry_cta_label || 'get in touch';
const enquiryAction: string = blok?.enquiry_action || '';

const h = splitHighlight(heading, accent);
---

<section class="s-hero" style={`--s-hero-bg: url('${bgImage}')`} {...storyblokEditable(blok)}>
	<div class="s-hero__inner container">
		<div class="s-hero__content">
			<p class="s-hero__eyebrow category">{eyebrow}</p>
			<h1 class="s-hero__heading">{h.pre}<span class="s-hero__hl">{h.mid}</span>{h.post}</h1>
			<p class="s-hero__body">{body}</p>
			<div class="s-hero__actions">
				{
					ctas.map((cta) => (
						<Button
							label={cta.label}
							link={cta.link}
							variant={cta.variant ?? 'primary'}
							icon={cta.icon ?? null}
						/>
					))
				}
			</div>
		</div>

		{layout === 'card' ? (
			<aside class="s-hero__card">
				<p class="s-hero__card-title">{cardTitle}</p>
				<ul class="s-hero__stats" role="list">
					{stats.map((s) => (
						<li class:list={['s-hero__stat', `is-${s.tone ?? 'pink'}`]}>
							<span class="s-hero__stat-value">{s.value}</span>
							<span class="s-hero__stat-label">{s.label}</span>
						</li>
					))}
				</ul>

				<form class="s-hero__form" id="hero-review" action="/api/report" method="post" data-js-enable novalidate>
					<p class="s-hero__form-title category">{formTitle}</p>
					<input type="hidden" name="source" value="hero" />
					<input type="hidden" name="page" value="" />
					<input class="lead-hp" type="text" name="hp_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
					<div class="s-hero__form-row" data-lead-fields>
						<label class="visually-hidden" for="hero-email">Your email address</label>
						<input
							class="s-hero__input"
							id="hero-email"
							type="email"
							name="email"
							placeholder="your@email.com"
							autocomplete="email"
							required
						/>
						<label class="visually-hidden" for="hero-url">Your website</label>
						<input
							class="s-hero__input"
							id="hero-url"
							type="url"
							name="url"
							placeholder="https://your.website.com/"
							autocomplete="url"
							required
						/>
						<Button label={formCtaLabel} variant="fuchsia" icon="arrow-right" type="submit" />
					</div>
					<p class="s-hero__form-note" data-js-status aria-live="polite">
						<span aria-hidden="true">🔒</span> {formNote}
					</p>
				</form>
			</aside>
		) : layout === 'enquiry' ? (
			<aside class="s-hero__card s-hero__card--enquiry">
				<form
					class="s-hero__form s-hero__form--enquiry"
					id="hero-enquiry"
					action={enquiryAction || undefined}
					method="post"
					data-js-enable={enquiryAction ? true : undefined}
					data-ui-only={enquiryAction ? undefined : true}
					novalidate
				>
					<p class="s-hero__enquiry-title">{enquiryTitle}</p>
					<input type="hidden" name="source" value="hero-enquiry" />
					<input type="hidden" name="page" value="" />
					<input class="lead-hp" type="text" name="hp_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
					<div class="s-hero__enquiry-grid">
					<label class="visually-hidden" for="enq-name">Full name</label>
					<input
						class="s-hero__input"
						id="enq-name"
						type="text"
						name="name"
						placeholder="Full name"
						autocomplete="name"
						required
					/>
					<label class="visually-hidden" for="enq-company">Company</label>
					<input
						class="s-hero__input"
						id="enq-company"
						type="text"
						name="company"
						placeholder="Company"
						autocomplete="organization"
						required
					/>
					<label class="visually-hidden" for="enq-email">Email address</label>
					<input
						class="s-hero__input"
						id="enq-email"
						type="email"
						name="email"
						placeholder="your@email.com"
						autocomplete="email"
						required
					/>
					<label class="visually-hidden" for="enq-phone">Phone number</label>
					<input
						class="s-hero__input"
						id="enq-phone"
						type="tel"
						name="phone"
						placeholder="Phone number"
						autocomplete="tel"
						required
					/>
					</div>
					<Button label={enquiryCtaLabel} variant="fuchsia" type="submit" class="s-hero__enquiry-submit" />
					<p class="s-hero__form-note" data-js-status aria-live="polite">
						<span aria-hidden="true">🔒</span> {formNote}
					</p>
				</form>
			</aside>
		) : (
		<div class="s-hero__media">
			{
				videoEmbed ? (
					<iframe
						class="s-hero__video"
						src={videoEmbed}
						title={videoTitle}
						loading="lazy"
						referrerpolicy="strict-origin-when-cross-origin"
						allow="autoplay; fullscreen; picture-in-picture"
						allowfullscreen
					/>
				) : videoFile ? (
					<video
						class="s-hero__video"
						src={videoFile}
						poster={videoPoster || undefined}
						controls
						playsinline
						preload="metadata"
					/>
				) : videoPoster ? (
					<img class="s-hero__video-poster" src={videoPoster} alt={videoTitle} loading="eager" />
				) : (
					<div class="s-hero__video-placeholder" aria-hidden="true" />
				)
			}
		</div>
		)}
	</div>
</section>

<!-- Video layout only: commitments + review form move to a band under the hero. -->
{layout === 'video' && (
<section class="s-commit">
	<div class="s-commit__inner container">
		<div class="s-commit__group">
			<p class="s-commit__title category">{cardTitle}</p>
			<ul class="s-commit__list" role="list">
				{
					stats.map((s) => (
						<li class:list={['s-commit__item', `is-${s.tone ?? 'pink'}`]}>
							<span class="s-commit__value">{s.value}</span>
							<span class="s-commit__label">{s.label}</span>
						</li>
					))
				}
			</ul>
		</div>

		<form class="s-commit__form" id="hero-review" action="/api/report" method="post" data-js-enable novalidate>
			<p class="s-commit__title category">{formTitle}</p>
			<input type="hidden" name="source" value="hero" />
			<input type="hidden" name="page" value="" />
			<input
				class="lead-hp"
				type="text"
				name="hp_url"
				tabindex="-1"
				autocomplete="off"
				aria-hidden="true"
			/>
			<div class="s-commit__form-row" data-lead-fields>
				<label class="visually-hidden" for="hero-email">Your email address</label>
				<input
					class="s-commit__input"
					id="hero-email"
					type="email"
					name="email"
					placeholder="your@email.com"
					autocomplete="email"
					required
				/>
				<label class="visually-hidden" for="hero-url">Your website</label>
				<input
					class="s-hero__input"
					id="hero-url"
					type="url"
					name="url"
					placeholder="https://your.website.com/"
					autocomplete="url"
					required
				/>
				<Button label={formCtaLabel} variant="fuchsia" icon="arrow-right" type="submit" />
			</div>
			<p class="s-commit__form-note" data-js-status aria-live="polite">
				<span aria-hidden="true">🔒</span> {formNote}
			</p>
		</form>
	</div>
</section>
)}

<style>
	.s-hero {
		position: relative;
		color: var(--color-white);
		background: var(--color-primary-blue);
		overflow: hidden;
	}
	/* Figma: building photo under an 80% Primary Blue overlay. */
	.s-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image: var(--s-hero-bg);
		background-size: cover;
		background-position: center;
		z-index: 0;
	}
	.s-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(84, 24, 208, 0.8);
		z-index: 0;
	}
	.s-hero__inner {
		position: relative;
		z-index: 1;
	}

	.s-hero__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: clamp(1.5rem, 3vw, 3.5rem);
		padding-block: clamp(3rem, 6vw, 6rem);
	}

	.s-hero__eyebrow {
		color: var(--color-light-yellow);
		margin-bottom: 1.25rem;
	}
	.s-hero__heading {
		color: var(--color-white);
		font-size: var(--fs-h1-fluid);
		font-weight: var(--fw-semibold);
		line-height: var(--lh-tight);
		letter-spacing: var(--ls-h1);
		white-space: pre-line;
		text-wrap: balance;
	}
	.s-hero__hl {
		color: var(--color-light-yellow);
	}
	@media (max-width: 560px) {
		.s-hero__heading {
			white-space: normal;
		}
	}
	.s-hero__body {
		max-width: 46ch;
		margin-top: 1.5rem;
		font-size: var(--fs-paragraph-fluid);
		line-height: var(--lh-body);
		color: var(--text-on-dark);
	}
	.s-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}
	/* Keep both CTAs on one line on desktop (matches the design); tighter
	   padding so they fit the hero content column. */
	.s-hero__actions :global(.btn) {
		padding-inline: 24px 20px;
		gap: 16px;
	}

	/* --- Response-commitments card --- */
	.s-hero__card {
		padding: clamp(1.5rem, 2vw, 2rem);
		background: rgba(42, 12, 103, 0.2);
		border: 1px solid rgba(248, 247, 250, 0.6);
		border-radius: var(--radius-card);
		backdrop-filter: blur(2px);
	}
	.s-hero__card-title {
		font-size: var(--fs-category);
		font-weight: var(--fw-semibold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-light-lavender);
		margin-bottom: 1rem;
	}
	.s-hero__stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin: 0 0 1.5rem;
		padding: 0;
	}
	.s-hero__stat {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.1rem 1.25rem;
		background: rgba(42, 12, 103, 0.45);
		border-radius: 0; /* Figma: inner commitment cells are sharp */
	}
	.s-hero__stat-value {
		font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.7rem);
		font-weight: var(--fw-semibold);
		line-height: 1.05;
		letter-spacing: var(--ls-h3);
	}
	.s-hero__stat-label {
		font-size: var(--fs-small);
		line-height: 1.3;
	}
	@media (min-width: 961px) {
		.s-hero__stat-label {
			white-space: nowrap; /* single line on desktop (per feedback) */
		}
	}
	.s-hero__stat.is-pink .s-hero__stat-value,
	.s-hero__stat.is-pink .s-hero__stat-label {
		color: var(--color-light-pink);
	}
	.s-hero__stat.is-green .s-hero__stat-value,
	.s-hero__stat.is-green .s-hero__stat-label {
		color: var(--color-light-green);
	}

	.s-hero__form-title {
		color: var(--text-on-dark);
		margin-bottom: 0.75rem;
	}
	.s-hero__form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
	}
	@media (max-width: 520px) {
		.s-hero__form-row {
			grid-template-columns: 1fr;
		}
	}
	.s-hero__input {
		flex: 1 1 12rem;
		min-width: 0;
		height: 54px;
		padding-inline: 1.25rem;
		border: 1px solid transparent;
		border-radius: 0; /* Figma: email input is sharp */
		background: var(--color-white-80);
		color: var(--color-headings-dark);
		font-size: var(--fs-small);
	}
	.s-hero__input::placeholder {
		color: #8a85a0;
	}
	.s-hero__input:focus-visible {
		outline: 2px solid var(--color-light-yellow);
		outline-offset: 2px;
	}
	.s-hero__form-row :global(.btn) {
		grid-column: 1 / -1;
		justify-self: start;
		padding-inline: 28px 22px;
	}
	.s-hero__form-note {
		margin-top: 1rem;
		font-size: var(--fs-small);
		color: var(--text-on-dark-muted);
	}
	.s-hero__form-note[data-state='ok'] {
		color: var(--color-light-green);
	}
	.s-hero__form-note[data-state='error'] {
		color: var(--color-light-pink);
	}

	/* --- Enquiry card (enquiry layout) --- */
	.s-hero__enquiry-title {
		font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
		font-weight: var(--fw-semibold);
		line-height: 1.25;
		letter-spacing: var(--ls-h3);
		color: var(--text-on-dark);
		margin-bottom: 1.25rem;
	}
	/* One field per row and a full-width submit, per the client mock. */
	.s-hero__enquiry-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.9rem;
		margin-bottom: 1.25rem;
	}
	.s-hero__card--enquiry {
		/* The mock panel is solid, not the translucent commitments card. */
		background: rgba(42, 12, 103, 0.92);
		/*
		 * Half the hero is far wider than four stacked fields need, so the card
		 * is capped and pushed to the outer edge of its column rather than
		 * stretched. Centred below the breakpoint, where it is the only column.
		 */
		max-width: 28rem;
		margin-inline: auto;
	}
	@media (min-width: 961px) {
		.s-hero__card--enquiry {
			margin-inline: auto 0;
		}
	}
	.s-hero__form--enquiry :global(.s-hero__enquiry-submit) {
		display: flex;
		width: 100%;
		padding-inline: 28px;
	}

	/* --- Hero video (video layout) --- */
	.s-hero__media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 0; /* Figma: sharp corners, consistent with other media */
		background: var(--color-dark-blue);
	}
	.s-hero__video,
	.s-hero__video-poster,
	.s-hero__video-placeholder {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.s-hero__video-poster {
		object-fit: cover;
	}
	.s-hero__video-placeholder {
		background: var(--surface-placeholder);
	}

	/* --- Response commitments + review form band --- */
	.s-commit {
		background: var(--color-dark-blue);
		color: var(--color-white);
	}
	.s-commit__inner {
		display: grid;
		/* Commitments take the wider share so all four stay on one row. */
		grid-template-columns: 1.75fr 1fr;
		gap: clamp(1.5rem, 3vw, 3rem);
		align-items: start;
		padding-block: clamp(2.25rem, 4vw, 3.25rem);
	}
	/* Let both columns shrink below their content so nothing widens the page. */
	.s-commit__group,
	.s-commit__form {
		min-width: 0;
	}
	.s-commit__title {
		color: var(--text-on-dark);
		margin-bottom: 1.5rem;
	}
	/* Four commitments across, separated by vertical rules (Figma). Sized to
	   their content rather than equal quarters so the labels stay on one line
	   in our narrower content column. */
	.s-commit__list {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1.25rem clamp(0.5rem, 1vw, 1rem);
		margin: 0;
		padding: 0;
	}
	.s-commit__item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-left: clamp(0.6rem, 1.2vw, 1.1rem);
		border-left: 1px solid var(--border-on-dark);
	}
	@media (min-width: 961px) {
		/* Single-line labels, as in the design. */
		.s-commit__label {
			white-space: nowrap;
		}
	}
	/* Rules sit BETWEEN items only — none before the first. */
	.s-commit__item:first-child {
		padding-left: 0;
		border-left: none;
	}
	.s-commit__value {
		font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.7rem);
		font-weight: var(--fw-semibold);
		line-height: 1.05;
		letter-spacing: var(--ls-h3);
	}
	.s-commit__label {
		font-size: var(--fs-small);
		line-height: 1.3;
	}
	.s-commit__item.is-pink .s-commit__value,
	.s-commit__item.is-pink .s-commit__label {
		color: var(--color-light-pink);
	}
	.s-commit__item.is-green .s-commit__value,
	.s-commit__item.is-green .s-commit__label {
		color: var(--color-light-green);
	}

	/* Two fields side by side, the button on the line beneath at its own width
	   — a flex row could only break the line by stretching it. */
	.s-commit__form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
	}
	@media (max-width: 520px) {
		.s-commit__form-row {
			grid-template-columns: 1fr;
		}
	}
	.s-commit__input {
		flex: 1 1 12rem;
		min-width: 0;
		height: 54px;
		padding-inline: 1.25rem;
		border: 1px solid transparent;
		border-radius: 0; /* Figma: email input is sharp */
		background: var(--color-white-80);
		color: var(--color-headings-dark);
		font-size: var(--fs-small);
	}
	.s-commit__input::placeholder {
		color: #8a85a0;
	}
	.s-commit__input:focus-visible {
		outline: 2px solid var(--color-light-yellow);
		outline-offset: 2px;
	}
	.s-commit__form-row :global(.btn) {
		grid-column: 1 / -1;
		justify-self: start;
		padding-inline: 28px 22px;
	}
	.s-commit__form-note {
		margin-top: 1rem;
		font-size: var(--fs-small);
		color: var(--text-on-dark-muted);
	}
	.s-commit__form-note[data-state='ok'] {
		color: var(--color-light-green);
	}
	.s-commit__form-note[data-state='error'] {
		color: var(--color-light-pink);
	}

	@media (max-width: 960px) {
		.s-hero__inner {
			grid-template-columns: 1fr;
		}
		.s-commit__inner {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 640px) {
		.s-commit__item {
			flex: 1 1 40%;
		}
		/* Wrapped onto two columns the rule belongs before right-hand cells only. */
		.s-commit__item:nth-child(odd) {
			padding-left: 0;
			border-left: none;
		}
	}
</style>

<script>
	import '../scripts/js-form';

	// The enquiry form has no destination yet. Keep it inert until one is set:
	// with no action it would otherwise POST to whatever page it sits on.
	document.querySelectorAll('form[data-ui-only]').forEach((form) => {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const note = form.querySelector('[data-js-status]');
			if (note) {
				note.textContent = 'Preview only - this form is not connected yet.';
				note.dataset.state = 'error';
			}
		});
	});
</script>
